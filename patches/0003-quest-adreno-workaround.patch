+  case GX_RGB565:
+    return fits_in_word(byteOffset, 2) ? fmt::format("unpack_rgb565(al_u16({}, {}u))", w, sub) : ""s;
+  case GX_RGBA4:
+    return fits_in_word(byteOffset, 2) ? fmt::format("unpack_rgba4(al_u16({}, {}u))", w, sub) : ""s;
+  case GX_RGB8:
+    return fits_in_word(byteOffset, 3)
