+const wgpu::ComputePipeline& compute_repro_pipeline(uint32_t kind, uint32_t vtxStride, uint32_t posOffset,
+                                                    uint32_t arrayStride) {
+  auto& cr = g_debugCompute;
+  for (const auto& p : cr.pipelines) {
+    if (p.kind == kind && p.vtxStride == vtxStride && p.posOffset == posOffset && p.arrayStride == arrayStride) {
+      return p.pipeline;
+    }
+  }
+  if (!cr.layout) {
+    const std::array entries{
+        wgpu::BindGroupLayoutEntry{
+            .binding = 0,
+            .visibility = wgpu::ShaderStage::Compute,
+            .buffer = {.type = wgpu::BufferBindingType::ReadOnlyStorage},
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 1,
+            .visibility = wgpu::ShaderStage::Compute,
+            .buffer = {.type = wgpu::BufferBindingType::ReadOnlyStorage},
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 2,
+            .visibility = wgpu::ShaderStage::Compute,
+            .buffer = {.type = wgpu::BufferBindingType::Storage},
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 3,
+            .visibility = wgpu::ShaderStage::Compute,
+            .buffer = {.type = wgpu::BufferBindingType::Uniform},
+        },
+    };
+    const wgpu::BindGroupLayoutDescriptor descriptor{
+        .label = "Compute repro layout",
+        .entryCount = entries.size(),
+        .entries = entries.data(),
+    };
+    cr.layout = g_device.CreateBindGroupLayout(&descriptor);
+  }
+  const auto source = kind == 0 ? compute_repro_source(vtxStride, posOffset, arrayStride)
+                                : compute_diag_source(vtxStride, posOffset);
+  const wgpu::ShaderSourceWGSL wgslSource{wgpu::ShaderSourceWGSL::Init{
+      .code = source.c_str(),
+  }};
+  const auto label = fmt::format("Compute repro kind={} stride={} off={} arr={}", kind, vtxStride, posOffset, arrayStride);
+  const wgpu::ShaderModuleDescriptor moduleDescriptor{
+      .nextInChain = &wgslSource,
+      .label = label.c_str(),
+  };
+  const auto module = g_device.CreateShaderModule(&moduleDescriptor);
+  const wgpu::PipelineLayoutDescriptor layoutDescriptor{
+      .bindGroupLayoutCount = 1,
+      .bindGroupLayouts = &cr.layout,
+  };
+  const auto pipelineLayout = g_device.CreatePipelineLayout(&layoutDescriptor);
+  const wgpu::ComputePipelineDescriptor pipelineDescriptor{
+      .label = label.c_str(),
+      .layout = pipelineLayout,
+      .compute =
+          wgpu::ComputeState{
+              .module = module,
+              .entryPoint = "cs_main",
+          },
+  };
+  cr.pipelines.push_back(DebugComputeRepro::Pipeline{
+      .kind = kind,
+      .vtxStride = vtxStride,
+      .posOffset = posOffset,
+      .arrayStride = arrayStride,
+      .pipeline = g_device.CreateComputePipeline(&pipelineDescriptor),
+  });
+  Log.info("compute repro: pipeline kind={} created for stride={} off={} arr={}", kind, vtxStride, posOffset, arrayStride);
+  return cr.pipelines.back().pipeline;
+}
