+  out_buf[base + 1u] = w1;
+  out_buf[base + 2u] = b0;
+  out_buf[base + 3u] = b1;
+  out_buf[base + 4u] = x0;
+  out_buf[base + 5u] = x1;
+  out_buf[base + 6u] = x2;
+  out_buf[base + 7u] = x3;
