+  // Byte at an absolute vertex-buffer offset, if it lies inside this draw's bytes.
+  const size_t drawBytes = static_cast<size_t>(vtxCount) * vtxSize;
+  const auto vbufByte = [&](u32 absolute, u32& out) -> bool {
+    if (absolute < vertRange.offset || absolute - vertRange.offset >= drawBytes) {
+      return false;
