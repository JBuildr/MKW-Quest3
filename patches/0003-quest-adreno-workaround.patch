+// `array_start` is declared as array<vec4u, 3> rather than array<u32, 12>: WGSL
+// requires uniform-address-space array strides to be multiples of 16 unless the
+// device offers the uniform_buffer_standard_layout language feature, and with
+// skip_validation nothing enforces that. Desktop drivers honoured the stride-4
+// decoration anyway; on the Adreno 740 (Quest 3) indexed 3D geometry came out as
+// garbage while direct-data 2D drew fine, and this layout is the one thing in
+// the vertex path that only indexed attributes touch. Packing four bases per
+// vec4u is valid WGSL everywhere and keeps the byte layout the CPU stages (12
+// consecutive u32) unchanged.
+auto array_start_expr(u32 arrayIndex) -> std::string {
+  return fmt::format("ubuf.array_start[{}][{}]", arrayIndex / 4u, arrayIndex % 4u);
+}
+
+// ---- Word-wise direct-attribute loads (Quest-3 workaround) ----
+// Every draw that does not merge starts 4-byte aligned (gfx::align_verts), so for a stride that
+// is a multiple of 4 every vertex base `ubuf.vtx_start + vidx * stride` is aligned and each
+// attribute's byte offset is a compile-time constant. Components that fit in one word are then
+// read as p[i] plus constant shifts; a component that would straddle a word (only possible in
+// game-provided direct formats with odd offsets) falls back to the byte-wise loads.
+static bool aligned_direct(const ShaderConfig& config, const AttrConfig& mapping) {
+  return mapping.attrType == GX_DIRECT && config.vtxStride % 4 == 0;
+}
+
+static bool fits_in_word(u32 byteOffset, u32 bytes) { return (byteOffset & 3u) + bytes <= 4; }
+
+static std::string aligned_word(std::string_view base, u32 byteOffset) {
+  return fmt::format("aw(&vbuf, {})", offset_plus(base, byteOffset & ~3u));
+}
+
+static std::string aligned_scalar(u8 compType, std::string_view base, u32 byteOffset) {
+  const u32 sub = byteOffset & 3u;
+  const auto w = aligned_word(base, byteOffset);
+  switch (static_cast<GXCompType>(compType)) {
+  case GX_U8:
+    return fmt::format("f32(al_u8({}, {}u))", w, sub);
+  case GX_S8:
+    return fmt::format("f32(al_s8({}, {}u))", w, sub);
+  case GX_U16:
+    return fmt::format("f32(al_u16({}, {}u))", w, sub);
+  case GX_S16:
+    return fmt::format("f32(al_s16({}, {}u))", w, sub);
+  case GX_F32:
+    return fmt::format("bitcast<f32>(bswap32({}, false))", w);
+  default:
+    Log.fatal("aligned_scalar: Unimplemented {}", static_cast<GXCompType>(compType));
+  }
+}
+
+// Empty when the attribute cannot be read word-wise.
+static std::string fetch_attr_aligned(const AttrConfig& mapping, std::string_view base, u32 byteOffset,
+                                      u8 cntOverride = 0) {
+  const u8 cnt = cntOverride != 0 ? cntOverride : mapping.cnt;
+  if (mapping.compType == GX_RGBA8) {
+    return fits_in_word(byteOffset, 4) ? fmt::format("unpack4x8unorm({})", aligned_word(base, byteOffset)) : ""s;
+  }
+  const u32 compSize = attr_comp_type_size(mapping.compType);
+  std::string comps;
+  for (u32 i = 0; i < cnt; ++i) {
+    const u32 off = byteOffset + i * compSize;
+    if (!fits_in_word(off, compSize)) {
+      return ""s;
+    }
+    if (i != 0) {
+      comps += ", ";
+    }
+    comps += aligned_scalar(mapping.compType, base, off);
+  }
+  std::string value = cnt == 1 ? comps : fmt::format("vec{}f({})", cnt, comps);
+  if (mapping.compType != GX_F32) {
+    value = fmt::format("({} / f32(1u << {}u))", value, mapping.frac);
+  }
+  return value;
+}
