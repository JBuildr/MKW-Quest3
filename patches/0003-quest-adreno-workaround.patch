+    vbufByte(absolute + 1, ew[3]);
+    const u8* p = vertices + static_cast<size_t>(v) * vtxSize + req.posOffset;
+    const u32 idx = (static_cast<u32>(p[0]) << 8) | p[1];
+    const u32 off = idx * array.stride;
+    u32* e = req.expected.data() + static_cast<size_t>(v) * 4;
