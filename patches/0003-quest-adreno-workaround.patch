+fn load_u8(p: ptr<storage, array<u32>>, byte_off: u32) -> u32 {{
+  let word = p[byte_off / 4u];
+  let shift = (byte_off & 3u) * 8u;
+  return (word >> shift) & 0xFFu;
+}}
+
+struct Params {{
+  vtx_start: u32,
+  array_start: u32,
+  count: u32,
+  pad: u32,
+}};
+
+@group(0) @binding(0)
+var<storage, read> vbuf: array<u32>;
+@group(0) @binding(1)
+var<storage, read> abuf: array<u32>;
+@group(0) @binding(2)
+var<storage, read_write> out_buf: array<u32>;
+@group(0) @binding(3)
+var<uniform> params: Params;
+
+@compute @workgroup_size(64)
+fn cs_main(@builtin(global_invocation_id) id: vec3u) {{
+  let vidx = id.x;
+  if (vidx >= params.count) {{
+    return;
+  }}
+  let off = params.vtx_start + vidx * {0}u + {1}u;
+  let sub = off & 3u;
+  let w0 = vbuf[off >> 2u];
+  let w1 = vbuf[(off >> 2u) + 1u];
