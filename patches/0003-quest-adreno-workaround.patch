+// Returns the number of indices that pointed beyond their array (written as zeros).
+static u32 deindex_vertices(const DeindexPlan& plan, const u8* src, u16 vtxCount, u8* dst) noexcept {
+  u32 outOfRange = 0;
+  for (u32 v = 0; v < vtxCount; ++v) {
+    const u8* sv = src + static_cast<size_t>(v) * plan.srcStride;
+    u8* dv = dst + static_cast<size_t>(v) * plan.dstStride;
+    std::memset(dv, 0, plan.dstStride); // alignment padding between attributes
+    for (u32 n = 0; n < plan.count; ++n) {
+      const auto& a = plan.attrs[n];
+      if (a.indexSize == 0) {
+        std::memcpy(dv + a.dstOffset, sv + a.srcOffset, a.bytes);
+        continue;
+      }
+      for (u32 k = 0; k < a.indexCount; ++k) {
+        const u8* p = sv + a.srcOffset + k * a.indexSize;
+        const u32 idx = a.indexSize == 2 ? (static_cast<u32>(p[0]) << 8) | p[1] : p[0];
+        const u32 off = idx * a.arrayStride;
+        u8* out = dv + a.dstOffset + k * a.bytes;
+        if (off + a.bytes <= a.arraySize) LIKELY {
+          std::memcpy(out, a.array + off, a.bytes);
+        } else {
+          // Same result as the GPU's robust storage access: out-of-range reads yield zero.
+          std::memset(out, 0, a.bytes);
+          ++outOfRange;
+        }
+      }
+    }
+  }
+  return outOfRange;
+}
