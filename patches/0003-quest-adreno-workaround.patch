+// Quest-3 diagnostics (AURORA_GX_DEBUG bit 2048): hands one unmerged draw with a 16-bit-indexed
+// f32 position per 180 frames to the compute replay in gfx (DebugComputeReproRequest), together
+// with the index and position words the CPU reads from the same FIFO bytes and array.
+static void debug_record_compute_repro(GXVtxFmt fmt, const u8* vertices, u16 vtxCount, u32 vtxSize,
+                                       gfx::Range vertRange) noexcept {
+  if ((gx_debug_flags() & GxDebugComputeRepro) == 0 || !gfx::debug_compute_repro_wanted()) {
+    return;
