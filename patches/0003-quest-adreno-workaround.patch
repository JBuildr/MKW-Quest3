+
+void complete_compute_repro() {
+  auto& cr = g_debugCompute;
+  if (!cr.pending) {
+    return;
+  }
+  cr.pending = false;
+  const auto& req = cr.inFlight;
+  const uint64_t bytes = DebugComputeRepro::kOutBytes;
+  wgpu::MapAsyncStatus mapStatus = wgpu::MapAsyncStatus::CallbackCancelled;
+  const auto future = cr.readback.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::WaitAnyOnly,
+                                           [&mapStatus](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                                             mapStatus = status;
+                                           });
+  const auto waitStatus = g_instance.WaitAny(future, 5000000000);
+  if (waitStatus != wgpu::WaitStatus::Success || mapStatus != wgpu::MapAsyncStatus::Success) {
+    Log.warn("compute repro frame {}: map failed wait={} map={}", cr.frame, magic_enum::enum_name(waitStatus),
+             magic_enum::enum_name(mapStatus));
+    return;
+  }
+  const auto* gpu = static_cast<const uint32_t*>(cr.readback.GetConstMappedRange(0, bytes));
+  const uint32_t* diag = gpu + static_cast<size_t>(DebugComputeRepro::kMaxVertices) * 4;
+  // Per formulation: how many vertices read the index bytes wrongly (w0, w1, b0, b1, x0..x3).
+  std::array<uint32_t, 8> diagWrong{};
+  uint32_t diagCompared = 0;
+  uint32_t idxMismatches = 0;
+  uint32_t posMismatches = 0;
+  uint32_t straddling = 0; // vertices whose 16-bit index crosses a 4-byte word boundary
+  std::string sample;
+  uint32_t sampled = 0;
+  for (uint32_t v = 0; v < req.count; ++v) {
+    const uint32_t* e = req.expected.data() + static_cast<size_t>(v) * 4;
+    const uint32_t* g = gpu + static_cast<size_t>(v) * 4;
+    const bool idxBad = e[0] != g[0];
+    const bool posBad = e[1] != g[1] || e[2] != g[2] || e[3] != g[3];
+    const uint32_t indexByte = req.vtxStart + v * req.vtxStride + req.posOffset;
+    const bool straddles = (indexByte & 3u) == 3u;
+    if (straddles) {
+      ++straddling;
+    }
+    if (idxBad) {
+      ++idxMismatches;
+    }
+    if (posBad) {
+      ++posMismatches;
+    }
+    const uint32_t* ew = req.expectedWords.data() + static_cast<size_t>(v) * 4;
+    const uint32_t* d = diag + static_cast<size_t>(v) * 8;
+    if (ew[0] != UINT32_MAX && ew[1] != UINT32_MAX) {
+      ++diagCompared;
+      diagWrong[0] += d[0] != ew[0];
+      diagWrong[1] += d[1] != ew[1];
+      diagWrong[2] += d[2] != ew[2];
+      diagWrong[3] += d[3] != ew[3];
+      for (size_t k = 4; k < 8; ++k) {
+        diagWrong[k] += d[k] != ew[2];
+      }
+    }
+    if ((idxBad || posBad) && sampled < 6) {
+      ++sampled;
+      sample += fmt::format(" [v{} byte {:#x} sub={}: idx cpu={} gpu={} w0 {:#010x}/{:#010x} w1 {:#010x}/{:#010x} b0 {}/{} b1 {}/{} "
+                            "ext={} sel={} sw={} inl={} pos cpu=({:g},{:g},{:g}) gpu=({:g},{:g},{:g})]",
+                            v, indexByte, indexByte & 3u, e[0], g[0], ew[0], d[0], ew[1], d[1], ew[2], d[2], ew[3], d[3],
+                            d[4], d[5], d[6], d[7], std::bit_cast<float>(e[1]),
+                            std::bit_cast<float>(e[2]), std::bit_cast<float>(e[3]), std::bit_cast<float>(g[1]),
+                            std::bit_cast<float>(g[2]), std::bit_cast<float>(g[3]));
+    }
+  }
+  if (idxMismatches == 0 && posMismatches == 0) {
+    Log.info("compute repro frame {}: stride={} off={} arr={} vtx_start={:#x} array_start={:#x} count={} "
+             "({} straddling): index and position IDENTICAL to the CPU -> fault is vertex-stage specific",
+             cr.frame, req.vtxStride, req.posOffset, req.arrayStride, req.vtxStart, req.arrayStart, req.count,
+             straddling);
+  } else {
+    Log.warn("compute repro frame {}: stride={} off={} arr={} vtx_start={:#x} array_start={:#x} count={} "
+             "({} straddling): {} index and {} position mismatches -> reproduces in compute{}",
+             cr.frame, req.vtxStride, req.posOffset, req.arrayStride, req.vtxStart, req.arrayStart, req.count,
+             straddling, idxMismatches, posMismatches, sample);
+  }
+  Log.info("compute diag frame {}: of {} vertices wrong: w0={} w1={} b0(load_u8)={} b1={} extractBits={} select={} "
+           "switch={} inline_shift={}",
+           cr.frame, diagCompared, diagWrong[0], diagWrong[1], diagWrong[2], diagWrong[3], diagWrong[4], diagWrong[5],
+           diagWrong[6], diagWrong[7]);
+  cr.readback.Unmap();
+}
