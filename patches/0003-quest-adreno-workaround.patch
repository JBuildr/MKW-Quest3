+    u8 srcOffset = 0;  // byte offset inside the FIFO vertex
+    u8 dstOffset = 0;  // byte offset inside the expanded vertex
+    u8 bytes = 0;      // bytes copied per direct attribute, or per index for indexed ones
+    u8 indexSize = 0;  // 0 = direct copy, 1 or 2 = index width in bytes
+    u8 indexCount = 1; // 3 for NBT3 normals (three indices per vertex), otherwise 1
+    u8 arrayStride = 0;
+    const u8* array = nullptr;
+    u32 arraySize = 0;
+  };
