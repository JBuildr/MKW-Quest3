+  case GX_RGBX8:
+    return fits_in_word(byteOffset, 4) ? fmt::format("unpack_rgbx8({})", bytes4) : ""s;
+  case GX_RGBA8:
+    return fits_in_word(byteOffset, 4) ? fmt::format("unpack_rgba8({})", bytes4) : ""s;
+  default:
+    Log.fatal("fetch_color_attr_aligned: Unimplemented {}", static_cast<GXCompType>(mapping.compType));
+  }
