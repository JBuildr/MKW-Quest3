+XrSharedTargetRelease xr_end_shared_target_access(void* hardwareBuffer) noexcept {
+  const std::lock_guard lock(g_sharedTargetMutex);
+  SharedTarget* target = find_shared_target(hardwareBuffer);
+  if (target == nullptr || !target->accessActive) {
+    return {-1, kVkImageLayoutUndefined};
+  }
+  // Cleared before the call can fail: a buffer whose access is stuck open can never be handed out
+  // again, and the alternative is refusing the buffer for the rest of the session.
+  target->accessActive = false;
+  // The end-access state owns the fences it reports and releases them when it leaves this scope
+  // (Dawn's FreeMembers runs from its destructor), so a descriptor has to be duplicated out of it
+  // before that happens.
+  // Dawn chooses the layout it releases the image in and only reports it back through this chained
+  // out-struct; the reader on the other device needs it for its acquire barrier, so it is carried
+  // with the frame instead of being assumed over there.
+  wgpu::SharedTextureMemoryVkImageLayoutEndState layoutState;
+  wgpu::SharedTextureMemoryEndAccessState endState;
+  endState.nextInChain = &layoutState;
