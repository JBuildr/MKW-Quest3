+void BridgeDiscardTarget(void* hardwareBuffer) {
+    const std::lock_guard<std::mutex> lock(g_ring.mutex);
+    for (SharedFrame& frame : g_ring.frames) {
+        if (frame.buffer == hardwareBuffer && frame.state == SharedFrame::State::WithAurora) {
+            frame.state = SharedFrame::State::Free;
+            return;
+        }
+    }
