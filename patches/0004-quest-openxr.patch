+#include "vr_game_state.h"
+
+#include <cstring>
+#include <iterator>
+#include <mutex>
+
+// The game's own frame counter, advanced by GXCopyDisp in gx_copy.cpp and
+// defined in gx_utils.cpp. Declared here rather than through gx_internal.h,
+// which is private to the GX sources -- the same way dynamic_aspect.cpp reaches
+// it.
+extern "C" int g_gxFrameCount;
+
+#include "guest_flat_memory.h"
+#include "memory_access.h"
+
+namespace VrGameState {
+namespace {
+
+// SectionMgr::CreateInstance (0x80634C90) writes the singleton here.
+constexpr uint32_t kSectionMgrPointer = 0x809C1E38u;
+// SectionMgr::Update (0x8063550C) passes the current Section* to Section::Update
+// (0x806224F8) as `r3 = FlatRead32(r30)` with r30 the manager itself, so the
+// pointer is the manager's first word. Offset 48 was tried first and is a flag
+// that only picks a branch: it reads a persistent zero and led nowhere.
+constexpr uint32_t kCurrentSectionOffset = 0u;
+
+// Kart::Manager::CreateInstance (0x8058FAA8) writes its singleton here, in the
+// same way SectionMgr does.
+constexpr uint32_t kKartManagerPointer = 0x809C18F8u;
+// Kart::Manager::GetKartPlayer (0x80590100): read32(this + 32) then index * 4.
+constexpr uint32_t kKartPlayerArrayOffset = 32u;
+// Kart::Link::GetKartBodyMtx (0x80590278): read32(read32(this) + 8) then + 28.
+constexpr uint32_t kKartBodyMatrixOffset = 28u;
+// Kart::Link::SetCamera (0x80590DF8) stores the camera at read32(this) + 36, and
+// Kart::Link::HasCamera reads the same word -- its `& 1` is the usual PowerPC
+// spelling of "this pointer is not null", not a flag.
+constexpr uint32_t kKartCameraOffset = 36u;
+// GameCamera::GetViewMatrix (0x80562BF0) is `this + 4` and nothing else.
+constexpr uint32_t kCameraViewMatrixOffset = 4u;
+
+// Kart::Link::GetDriverController (0x80590A40): read32(read32(this) + 20), so
+// the driver sits in the same object as the body at +8 and the camera at +36.
+constexpr uint32_t kKartDriverControllerOffset = 20u;
+// DriverController::__ct builds 36 entries of 96 bytes at this + 260, and
+// DriverController::Load fills them in the order of the game's own name table.
+constexpr uint32_t kDriverBoneArrayOffset = 260u;
+constexpr uint32_t kDriverBoneStride = 96u;
+constexpr uint32_t kDriverBoneCountOffset = 272u;
+// Per entry: the ResNodeData the name resolved to, and the matrix id taken from
+// that node's +16. A node of zero means the model does not have that bone.
+constexpr uint32_t kBoneNodeOffset = 24u;
+constexpr uint32_t kBoneMatrixIdOffset = 28u;
+// Indices into the game's own bone-name table at 0x809C3DB8, whose strings sit
+// at 0x808A7288. The whole table was read out of the blob rather than sampled:
+//   0 skl_root   1 leg_l1    2 leg_l2    3 ankle_l1  4 leg_r1    5 leg_r2
+//   6 ankle_r1   7 spin      8 arm_l1    9 arm_l2   10 wrist_l1 11 arm_r1
+//  12 arm_r2    13 wrist_r1 14 face_1   15 cap1     16 mouth_1  17 ca_mouth_1
+//  18 yo_mouth_1 19-21 tang_1..3  22 tie_1  23 wing_l1 24 wing_r1
+//  25-27 tail_1..3  28 skirt_1  29-30 d_hair_1..2  31-32 p_hair_1..2
+//  33-35 unknown_1..3
+// Which settles a question that was open: there is no eye bone and no head-top
+// bone other than cap1, so face_1 is the highest joint a driver is guaranteed
+// to have. 33 named entries -- indices 0 to 32 -- is exactly what dc + 272
+// reported on the device.
+constexpr uint32_t kRootBoneIndex = 0u;
+constexpr uint32_t kHeadBoneIndex = 14u;
+constexpr uint32_t kCapBoneIndex = 15u;
+// DriverController::CreateModelDirectors hands out this + 108 for the driver's
+// model and this + 112 for the second one.
+constexpr uint32_t kDriverModelDirectorOffset = 108u;
+// ModelDirector::InitG3D stores the ScnMdlEx at +20 and then copies that same
+// pointer into +16, so +16 is not a handle of its own and +24 is the second
+// model. Reading +20 is the honest spelling of the two.
+constexpr uint32_t kModelDirectorSceneOffset = 20u;
+constexpr uint32_t kSceneHandleTagOffset = 4u;
+// ScnMdlSimple's matrices, 48 bytes apart, indexed by the bone's matrix id.
+// +244 next door is the view-matrix array and is NOT this.
+constexpr uint32_t kSceneMatrixArrayOffset = 236u;
+constexpr uint32_t kSceneMatrixStride = 48u;
+// Six floats: the scene object's world bounding box.
+constexpr uint32_t kSceneWorldBoxOffset = 180u;
+// A matrix id indexes an array whose length this cannot see, so it gets a
+// ceiling no real skeleton reaches. Garbage read mid-write would otherwise turn
+// into an address a long way from the array.
+constexpr uint32_t kMaxPlausibleMatrixId = 1024u;
+// Two windows the LATER question needs -- which word holds the driver's model
+// list and which its count. Logged raw, not interpreted.
+constexpr uint32_t kDriverModelWordsOffset = 104u;
+constexpr uint32_t kDriverListWordsOffset = 212u;
+
+// The driver's own models, read off the device rather than deduced: build 45
+// logged the raw words and dc + 216 held the same ModelDirector as dc + 108,
+// dc + 220 the second one, and dc + 240 the count, which was 2. So the list is
+// inline at +216 with no indirection, and the model the camera reads its head
+// from is the first entry of it -- which is exactly what had to be true for
+// hiding and reading to agree about who the driver is.
+constexpr uint32_t kDriverModelListOffset = 216u;
+constexpr uint32_t kDriverModelCountOffset = 240u;
+// More than this is not a list, it is a misread pointer.
+constexpr uint32_t kMaxDriverModels = 8u;
+// ModelDirector::InitG3D fills +20 and +24 with the two ScnMdlEx slots.
+constexpr uint32_t kModelDirectorSecondSceneOffset = 24u;
+// ScnObj + 204: the gather stage reads these two bits and leaves the object out
+// of the opaque and the translucent list respectively.
+constexpr uint32_t kSceneObjectFlagsOffset = 204u;
+constexpr uint32_t kSceneObjectSkipOpaque = 0x20000000u;
+constexpr uint32_t kSceneObjectSkipXlu = 0x40000000u;
+
+// MEM1 plus MEM2 as the Wii lays them out. A pointer outside this is either a
+// null the game has not filled in yet or garbage from reading while the guest
+// was mid-write, and following it would fault the whole app for a diagnostic.
+bool plausible_guest_pointer(uint32_t address) noexcept {
+    const bool mem1 = address >= 0x80000000u && address < 0x81800000u;
+    const bool mem2 = address >= 0x90000000u && address < 0x94000000u;
+    return (mem1 || mem2) && (address & 3u) == 0u;
+}
+
+// One float out of guest memory. The game stores big-endian and FlatRead32 has
+// already turned that into the host's order, so only the bits have to be moved
+// into a float without going through a numeric conversion.
+float read_guest_float(uint32_t address) noexcept {
+    const uint32_t bits = MemoryInline::FlatRead32(address);
+    float value = 0.0f;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+// -ffast-math deletes std::isfinite outright, so this asks the bits the way
+// sanitize_light_dir_component already does in the renderer: an exponent of all
+// ones is an infinity or a NaN, everything else is a number.
+bool finite_float(float value) noexcept {
+    uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    return (bits & 0x7F800000u) != 0x7F800000u;
+}
+
+// A 3x4 the way the game stores them: row-major, translation in column 3, so
+// words 3, 7 and 11. A matrix with a non-number anywhere in it is a matrix read
+// while the guest was writing it, and half of one is worse than none.
+bool read_matrix_3x4(uint32_t address, float out[12]) noexcept {
+    for (uint32_t i = 0; i < 12u; ++i) {
+        out[i] = read_guest_float(address + i * 4u);
+        if (!finite_float(out[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// The kart and the camera hang off the same object, so both are reached in one
+// walk instead of two.
+bool read_kart_inner(uint32_t& inner) noexcept {
+    const uint32_t manager = MemoryInline::FlatRead32(kKartManagerPointer);
+    if (!plausible_guest_pointer(manager)) {
+        return false;
+    }
+    const uint32_t players = MemoryInline::FlatRead32(manager + kKartPlayerArrayOffset);
+    if (!plausible_guest_pointer(players)) {
+        return false;
+    }
+    // Player 0. Splitscreen is not something a headset does.
+    const uint32_t link = MemoryInline::FlatRead32(players);
+    if (!plausible_guest_pointer(link)) {
+        return false;
+    }
+    inner = MemoryInline::FlatRead32(link);
+    return plausible_guest_pointer(inner);
+}
+
+} // namespace
+
+bool Snapshot::operator==(const Snapshot& rhs) const noexcept {
+    if (valid != rhs.valid || rawManager != rhs.rawManager || rawSection != rhs.rawSection) {
+        return false;
+    }
+    if (!valid) {
+        return true;
+    }
+    if (sectionAddress != rhs.sectionAddress) {
+        return false;
+    }
+    for (size_t i = 0; i < std::size(words); ++i) {
+        if (words[i] != rhs.words[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+Snapshot Read() noexcept {
+    Snapshot snapshot{};
+
+    snapshot.checkedAccess = GuestFlat::RequiresCheckedAccess();
+
+    const uint32_t manager = MemoryInline::FlatRead32(kSectionMgrPointer);
+    snapshot.rawManager = manager;
+    if (!plausible_guest_pointer(manager)) {
+        return snapshot;
+    }
+    const uint32_t section = MemoryInline::FlatRead32(manager + kCurrentSectionOffset);
+    snapshot.rawSection = section;
+    if (!plausible_guest_pointer(section)) {
+        return snapshot;
+    }
+
+    snapshot.valid = true;
+    snapshot.sectionAddress = section;
+    for (uint32_t i = 0; i < std::size(snapshot.words); ++i) {
+        snapshot.words[i] = MemoryInline::FlatRead32(section + i * 4u);
+    }
+    return snapshot;
+}
+
+uint32_t SectionId(const Snapshot& snapshot) noexcept {
+    return snapshot.valid ? snapshot.words[0] : 0u;
+}
+
+KartPose ReadKartPose() noexcept {
+    KartPose pose{};
+
+    const uint32_t manager = MemoryInline::FlatRead32(kKartManagerPointer);
+    if (!plausible_guest_pointer(manager)) {
+        return pose;
+    }
+    const uint32_t players = MemoryInline::FlatRead32(manager + kKartPlayerArrayOffset);
+    if (!plausible_guest_pointer(players)) {
+        return pose;
+    }
+    // Player 0. Splitscreen is not something a headset does, so there is exactly
+    // one seat to put someone in.
+    const uint32_t link = MemoryInline::FlatRead32(players);
+    if (!plausible_guest_pointer(link)) {
+        return pose;
+    }
+    const uint32_t inner = MemoryInline::FlatRead32(link);
+    if (!plausible_guest_pointer(inner)) {
+        return pose;
+    }
+    const uint32_t body = MemoryInline::FlatRead32(inner + 8u);
+    if (!plausible_guest_pointer(body)) {
+        return pose;
+    }
+
+    const uint32_t matrix = body + kKartBodyMatrixOffset;
+    for (uint32_t i = 0; i < 12u; ++i) {
+        const uint32_t bits = MemoryInline::FlatRead32(matrix + i * 4u);
+        std::memcpy(&pose.matrix[i], &bits, sizeof(float));
+    }
+    // A matrix full of nothing means the race has not built its karts yet, and
+    // following it would put the eye at the world origin -- underground, on most
+    // courses.
+    pose.valid = pose.matrix[0] != 0.0f || pose.matrix[5] != 0.0f || pose.matrix[10] != 0.0f;
+    return pose;
+}
+
+SeatTarget ReadSeatTarget() noexcept {
+    SeatTarget target{};
+
+    uint32_t inner = 0;
+    if (!read_kart_inner(inner)) {
+        return target;
+    }
+    const uint32_t body = MemoryInline::FlatRead32(inner + 8u);
+    const uint32_t camera = MemoryInline::FlatRead32(inner + kKartCameraOffset);
+    if (!plausible_guest_pointer(body) || !plausible_guest_pointer(camera)) {
+        return target;
+    }
+
+    // The kart's world position: the translation column of its body matrix,
+    // which the game stores as a 3x4 in row order, so the column is words 3, 7
+    // and 11.
+    const uint32_t bodyMatrix = body + kKartBodyMatrixOffset;
+    const float kartX = read_guest_float(bodyMatrix + 3u * 4u);
+    const float kartY = read_guest_float(bodyMatrix + 7u * 4u);
+    const float kartZ = read_guest_float(bodyMatrix + 11u * 4u);
+
+    // The game's own world-to-view matrix, the same 3x4 shape. Applying it to
+    // the kart gives the kart as the camera sees it, which is exactly the vector
+    // the renderer's add-on wants -- no metre, no scale, nothing guessed.
+    const uint32_t view = camera + kCameraViewMatrixOffset;
+    float m[12]{};
+    for (uint32_t i = 0; i < 12u; ++i) {
+        m[i] = read_guest_float(view + i * 4u);
+    }
+
+    // A matrix of nothing means the race has not built its camera yet; following
+    // it would put the seat at the world origin.
+    if (m[0] == 0.0f && m[5] == 0.0f && m[10] == 0.0f) {
+        return target;
+    }
+
+    target.x = m[0] * kartX + m[1] * kartY + m[2] * kartZ + m[3];
+    target.y = m[4] * kartX + m[5] * kartY + m[6] * kartZ + m[7];
+    target.z = m[8] * kartX + m[9] * kartY + m[10] * kartZ + m[11];
+    // Behind the camera or on top of it is not a seat. The game's chase camera
+    // always looks at the kart from behind, so a non-negative z means something
+    // was read that is not what this thinks it is, and moving the eye there
+    // would be worse than not moving it at all.
+    target.valid = target.z < 0.0f;
+    return target;
+}
+
+SeatTarget ReadSeatPoint(float height, float forward) noexcept {
+    SeatTarget target{};
+
+    uint32_t inner = 0;
+    if (!read_kart_inner(inner)) {
+        return target;
+    }
+    const uint32_t body = MemoryInline::FlatRead32(inner + 8u);
+    const uint32_t camera = MemoryInline::FlatRead32(inner + kKartCameraOffset);
+    if (!plausible_guest_pointer(body) || !plausible_guest_pointer(camera)) {
+        return target;
+    }
+
+    float bodyMatrix[12]{};
+    if (!read_matrix_3x4(body + kKartBodyMatrixOffset, bodyMatrix)) {
+        return target;
+    }
+    // All-zero means the race has not built its karts yet, and the seat would be
+    // at the world origin -- underground, on most courses.
+    if (bodyMatrix[0] == 0.0f && bodyMatrix[5] == 0.0f && bodyMatrix[10] == 0.0f) {
+        return target;
+    }
+
+    // Up and back along the kart's own axes, then out through its own matrix.
+    // This is a forward multiply, not the transpose used for measuring, so it
+    // stays correct even when the matrix carries a scale -- which is what a mega
+    // mushroom is, and why the eye should grow with the kart without being told.
+    const float lx = 0.0f;
+    const float ly = height;
+    const float lz = forward;
+    const float eyeX = bodyMatrix[0] * lx + bodyMatrix[1] * ly + bodyMatrix[2] * lz + bodyMatrix[3];
+    const float eyeY = bodyMatrix[4] * lx + bodyMatrix[5] * ly + bodyMatrix[6] * lz + bodyMatrix[7];
+    const float eyeZ =
+        bodyMatrix[8] * lx + bodyMatrix[9] * ly + bodyMatrix[10] * lz + bodyMatrix[11];
+
+    // Through the game's own world-to-view matrix, which is the space the
+    // headset's per-eye add-on already works in. No metre, no world_scale.
+    float view[12]{};
+    if (!read_matrix_3x4(camera + kCameraViewMatrixOffset, view)) {
+        return target;
+    }
+    if (view[0] == 0.0f && view[5] == 0.0f && view[10] == 0.0f) {
+        return target;
+    }
+
+    target.x = view[0] * eyeX + view[1] * eyeY + view[2] * eyeZ + view[3];
+    target.y = view[4] * eyeX + view[5] * eyeY + view[6] * eyeZ + view[7];
+    target.z = view[8] * eyeX + view[9] * eyeY + view[10] * eyeZ + view[11];
+    // The game's chase camera looks at the kart from behind, so the seat is in
+    // front of it and z is negative. A non-negative z means something was read
+    // that is not what this thinks it is, and moving the eye there would be
+    // worse than not moving it at all.
+    target.valid = target.z < 0.0f;
+    return target;
+}
+
+HeadProbe ReadHeadProbe() noexcept {
+    HeadProbe probe{};
+
+    uint32_t inner = 0;
+    if (!read_kart_inner(inner)) {
+        return probe;
+    }
+    probe.inner = inner;
+
+    const uint32_t driver = MemoryInline::FlatRead32(inner + kKartDriverControllerOffset);
+    if (!plausible_guest_pointer(driver)) {
+        return probe;
+    }
+    probe.driverController = driver;
+    // Free of charge, because DriverController derives from Kart::Link: its own
+    // first word has to be the accessor this walk started from.
+    probe.selfCheck = MemoryInline::FlatRead32(driver);
+    probe.namedBoneCount = MemoryInline::FlatRead32(driver + kDriverBoneCountOffset);
+
+    // The two windows for the question after this one. Read, not interpreted.
+    for (uint32_t i = 0; i < 6u; ++i) {
+        probe.modelWords[i] = MemoryInline::FlatRead32(driver + kDriverModelWordsOffset + i * 4u);
+    }
+    for (uint32_t i = 0; i < 9u; ++i) {
+        probe.listWords[i] = MemoryInline::FlatRead32(driver + kDriverListWordsOffset + i * 4u);
+    }
+
+    const uint32_t bones = MemoryInline::FlatRead32(driver + kDriverBoneArrayOffset);
+    if (!plausible_guest_pointer(bones)) {
+        return probe;
+    }
+    probe.boneArray = bones;
+
+    const uint32_t rootEntry = bones + kRootBoneIndex * kDriverBoneStride;
+    probe.rootNode = MemoryInline::FlatRead32(rootEntry + kBoneNodeOffset);
+    probe.rootMatrixId = MemoryInline::FlatRead32(rootEntry + kBoneMatrixIdOffset);
+    const uint32_t headEntry = bones + kHeadBoneIndex * kDriverBoneStride;
+    probe.headNode = MemoryInline::FlatRead32(headEntry + kBoneNodeOffset);
+    probe.headMatrixId = MemoryInline::FlatRead32(headEntry + kBoneMatrixIdOffset);
+    const uint32_t capEntry = bones + kCapBoneIndex * kDriverBoneStride;
+    probe.capNode = MemoryInline::FlatRead32(capEntry + kBoneNodeOffset);
+    probe.capMatrixId = MemoryInline::FlatRead32(capEntry + kBoneMatrixIdOffset);
+
+    const uint32_t director = MemoryInline::FlatRead32(driver + kDriverModelDirectorOffset);
+    if (!plausible_guest_pointer(director)) {
+        return probe;
+    }
+    probe.modelDirector = director;
+
+    const uint32_t handle = MemoryInline::FlatRead32(director + kModelDirectorSceneOffset);
+    if (!plausible_guest_pointer(handle)) {
+        return probe;
+    }
+    probe.sceneHandle = handle;
+    probe.sceneTag = MemoryInline::FlatRead32(handle + kSceneHandleTagOffset);
+    // The game's own readers take the first word as a scene model only for a tag
+    // of 0 or 1; anything else is a slot holding something different.
+    if (probe.sceneTag > 1u) {
+        return probe;
+    }
+
+    const uint32_t scene = MemoryInline::FlatRead32(handle);
+    if (!plausible_guest_pointer(scene)) {
+        return probe;
+    }
+    probe.sceneModel = scene;
+
+    const uint32_t matrices = MemoryInline::FlatRead32(scene + kSceneMatrixArrayOffset);
+    if (!plausible_guest_pointer(matrices)) {
+        return probe;
+    }
+    probe.matrixArray = matrices;
+
+    float headMatrix[12]{};
+    if (probe.headNode != 0u && plausible_guest_pointer(probe.headNode) &&
+        probe.headMatrixId < kMaxPlausibleMatrixId) {
+        const uint32_t address = matrices + probe.headMatrixId * kSceneMatrixStride;
+        if (plausible_guest_pointer(address) && read_matrix_3x4(address, headMatrix)) {
+            probe.headWorld[0] = headMatrix[3];
+            probe.headWorld[1] = headMatrix[7];
+            probe.headWorld[2] = headMatrix[11];
+            probe.headPointValid = true;
+        }
+    }
+
+    float rootMatrix[12]{};
+    if (probe.rootNode != 0u && plausible_guest_pointer(probe.rootNode) &&
+        probe.rootMatrixId < kMaxPlausibleMatrixId) {
+        const uint32_t address = matrices + probe.rootMatrixId * kSceneMatrixStride;
+        if (plausible_guest_pointer(address) && read_matrix_3x4(address, rootMatrix)) {
+            probe.rootWorld[0] = rootMatrix[3];
+            probe.rootWorld[1] = rootMatrix[7];
+            probe.rootWorld[2] = rootMatrix[11];
+            probe.rootPointValid = true;
+        }
+    }
+    // The head seen from the root, both out of the same array. Whatever clock
+    // that array runs on, it is the same clock at both ends, so this difference
+    // carries none of the drift the head-against-kart comparison showed.
+    if (probe.rootPointValid && probe.headPointValid) {
+        const float hx = probe.headWorld[0] - probe.rootWorld[0];
+        const float hy = probe.headWorld[1] - probe.rootWorld[1];
+        const float hz = probe.headWorld[2] - probe.rootWorld[2];
+        probe.headInRoot[0] = rootMatrix[0] * hx + rootMatrix[4] * hy + rootMatrix[8] * hz;
+        probe.headInRoot[1] = rootMatrix[1] * hx + rootMatrix[5] * hy + rootMatrix[9] * hz;
+        probe.headInRoot[2] = rootMatrix[2] * hx + rootMatrix[6] * hy + rootMatrix[10] * hz;
+    }
+
+    float capMatrix[12]{};
+    if (probe.capNode != 0u && plausible_guest_pointer(probe.capNode) &&
+        probe.capMatrixId < kMaxPlausibleMatrixId) {
+        const uint32_t address = matrices + probe.capMatrixId * kSceneMatrixStride;
+        if (plausible_guest_pointer(address) && read_matrix_3x4(address, capMatrix)) {
+            probe.capWorld[0] = capMatrix[3];
+            probe.capWorld[1] = capMatrix[7];
+            probe.capWorld[2] = capMatrix[11];
+            probe.capPointValid = true;
+        }
+    }
+
+    float box[6]{};
+    bool boxOk = true;
+    for (uint32_t i = 0; i < 6u; ++i) {
+        box[i] = read_guest_float(scene + kSceneWorldBoxOffset + i * 4u);
+        boxOk = boxOk && finite_float(box[i]);
+    }
+    if (boxOk) {
+        for (uint32_t i = 0; i < 6u; ++i) {
+            probe.worldBox[i] = box[i];
+        }
+        probe.boxValid = true;
+    }
+
+    // The kart, from the chain this file has been using since build 44. It is
+    // the reference the head is measured against, and it is also the only way to
+    // tell a world-space matrix from a parent-space one without being told.
+    const uint32_t body = MemoryInline::FlatRead32(inner + 8u);
+    float bodyMatrix[12]{};
+    if (!plausible_guest_pointer(body) ||
+        !read_matrix_3x4(body + kKartBodyMatrixOffset, bodyMatrix)) {
+        return probe;
+    }
+    probe.kartWorld[0] = bodyMatrix[3];
+    probe.kartWorld[1] = bodyMatrix[7];
+    probe.kartWorld[2] = bodyMatrix[11];
+    probe.kartValid = bodyMatrix[0] != 0.0f || bodyMatrix[5] != 0.0f || bodyMatrix[10] != 0.0f;
+    if (!probe.kartValid || !probe.headPointValid) {
+        return probe;
+    }
+
+    // Into the kart's own frame: the rotation of a body matrix is orthonormal,
+    // so undoing it is its transpose, and row i of the transpose is column i of
+    // the original. The result reads as "so far right, so far up, so far forward
+    // of the machine's origin" and says nothing different on a banked corner
+    // than it does on a straight, which is the whole point of taking the
+    // rotation out rather than subtracting two world points and hoping.
+    const float dx = probe.headWorld[0] - probe.kartWorld[0];
+    const float dy = probe.headWorld[1] - probe.kartWorld[1];
+    const float dz = probe.headWorld[2] - probe.kartWorld[2];
+    probe.headLocal[0] = bodyMatrix[0] * dx + bodyMatrix[4] * dy + bodyMatrix[8] * dz;
+    probe.headLocal[1] = bodyMatrix[1] * dx + bodyMatrix[5] * dy + bodyMatrix[9] * dz;
+    probe.headLocal[2] = bodyMatrix[2] * dx + bodyMatrix[6] * dy + bodyMatrix[10] * dz;
+    probe.localValid = true;
+
+    if (probe.rootPointValid) {
+        const float rx = probe.rootWorld[0] - probe.kartWorld[0];
+        const float ry = probe.rootWorld[1] - probe.kartWorld[1];
+        const float rz = probe.rootWorld[2] - probe.kartWorld[2];
+        probe.rootInKart[0] = bodyMatrix[0] * rx + bodyMatrix[4] * ry + bodyMatrix[8] * rz;
+        probe.rootInKart[1] = bodyMatrix[1] * rx + bodyMatrix[5] * ry + bodyMatrix[9] * rz;
+        probe.rootInKart[2] = bodyMatrix[2] * rx + bodyMatrix[6] * ry + bodyMatrix[10] * rz;
+    }
+
+    if (probe.capPointValid) {
+        const float cx = probe.capWorld[0] - probe.kartWorld[0];
+        const float cy = probe.capWorld[1] - probe.kartWorld[1];
+        const float cz = probe.capWorld[2] - probe.kartWorld[2];
+        probe.capLocal[0] = bodyMatrix[0] * cx + bodyMatrix[4] * cy + bodyMatrix[8] * cz;
+        probe.capLocal[1] = bodyMatrix[1] * cx + bodyMatrix[5] * cy + bodyMatrix[9] * cz;
+        probe.capLocal[2] = bodyMatrix[2] * cx + bodyMatrix[6] * cy + bodyMatrix[10] * cz;
+    }
+
+    probe.valid = true;
+    return probe;
+}
+
+namespace {
+
+// One scene object of a ModelDirector slot, or 0 when the slot holds nothing.
+// The tag decides: the game's own readers take the first word as a scene model
+// only for 0 or 1, and a slot that says anything else is not one.
+uint32_t scene_object_of_slot(uint32_t director, uint32_t slotOffset) noexcept {
+    const uint32_t handle = MemoryInline::FlatRead32(director + slotOffset);
+    if (!plausible_guest_pointer(handle)) {
+        return 0u;
+    }
+    if (MemoryInline::FlatRead32(handle + kSceneHandleTagOffset) > 1u) {
+        return 0u;
+    }
+    const uint32_t scene = MemoryInline::FlatRead32(handle);
+    return plausible_guest_pointer(scene) ? scene : 0u;
+}
+
+// Set or clear the two gather bits, and say whether anything actually changed.
+// Writing a word that already holds the wanted value would be harmless but it
+// would also hide a rebuild, and a rebuild is the one event worth counting.
+bool apply_scene_hidden(uint32_t scene, bool hidden) noexcept {
+    const uint32_t address = scene + kSceneObjectFlagsOffset;
+    const uint32_t before = MemoryInline::FlatRead32(address);
+    const uint32_t after = hidden ? (before | kSceneObjectSkipOpaque | kSceneObjectSkipXlu)
+                                  : (before & ~(kSceneObjectSkipOpaque | kSceneObjectSkipXlu));
+    if (after == before) {
+        return false;
+    }
+    MemoryInline::FlatWrite32(address, after);
+    return true;
+}
+
+// One reading, handed from the guest thread to whoever asks. A plain mutex
+// rather than anything clever: it is taken once per game frame by the writer
+// and once per use by the reader, so it is never contended in a way that costs
+// anything, and a torn hand-over is the exact failure this whole function exists
+// to remove.
+std::mutex g_headProbeMutex;
+HeadProbe g_headProbe;
+
+} // namespace
+
+void SampleHeadProbe() noexcept {
+    HeadProbe probe = ReadHeadProbe();
+    probe.guestFrame = static_cast<uint32_t>(g_gxFrameCount);
+    const std::lock_guard<std::mutex> lock(g_headProbeMutex);
+    g_headProbe = probe;
+}
+
+uint32_t SetDriverHidden(bool hidden) noexcept {
+    uint32_t inner = 0;
+    if (!read_kart_inner(inner)) {
+        return 0u;
+    }
+    const uint32_t driver = MemoryInline::FlatRead32(inner + kKartDriverControllerOffset);
+    if (!plausible_guest_pointer(driver)) {
+        return 0u;
+    }
+    // Derived from Kart::Link, so its own first word has to be the accessor this
+    // walk came from. Cheap, and it is the difference between writing into the
+    // driver and writing into whatever a stale pointer happens to point at --
+    // which matters a great deal more now that this writes.
+    if (MemoryInline::FlatRead32(driver) != inner) {
+        return 0u;
+    }
+
+    const uint32_t count = MemoryInline::FlatRead32(driver + kDriverModelCountOffset);
+    if (count == 0u || count > kMaxDriverModels) {
+        return 0u;
+    }
+
+    uint32_t changed = 0u;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t director =
+            MemoryInline::FlatRead32(driver + kDriverModelListOffset + i * 4u);
+        if (!plausible_guest_pointer(director)) {
+            continue;
+        }
+        const uint32_t first = scene_object_of_slot(director, kModelDirectorSceneOffset);
+        if (first != 0u && apply_scene_hidden(first, hidden)) {
+            ++changed;
+        }
+        const uint32_t second = scene_object_of_slot(director, kModelDirectorSecondSceneOffset);
+        // The second slot is a different scene object, not a copy: +16 is the
+        // copy of +20, +24 is its own. Skipping it would leave one of the two
+        // drawn, which looks like the hiding half worked.
+        if (second != 0u && second != first && apply_scene_hidden(second, hidden)) {
+            ++changed;
+        }
+    }
+    return changed;
+}
+
+HeadProbe LatestHeadProbe() noexcept {
+    const std::lock_guard<std::mutex> lock(g_headProbeMutex);
+    return g_headProbe;
+}
+
+bool IsRacingSection(uint32_t sectionId) noexcept {
+    // One entry, because one race is what was measured. Adding an id without
+    // measuring it would be exactly the guess this whole probe exists to avoid.
+    return sectionId == 30u;
+}
+
+} // namespace VrGameState
diff --git a/runtime/src/vr/vr_game_state.h b/runtime/src/vr/vr_game_state.h
new file mode 100644
index 0000000..f53fdc2
--- /dev/null
+++ b/runtime/src/vr/vr_game_state.h
@@ -0,0 +1,318 @@
+// Reading the game's own idea of where it is, so the headset can be a flat
+// screen in the menus and a world in the race without being told.
+//
+// Nothing here writes to guest memory and nothing here replaces a translated
+// function. That matters: the runtime's only override mechanism
+// (PPC_NATIVE_OVERRIDE) makes the translator SKIP the address, so hooking
+// SectionMgr::RaceUpdate to watch it would delete the game's race update. This
+// only looks.
+//
+// The addresses were read out of the translated code rather than guessed:
+// SectionMgr::CreateInstance (0x80634C90) stores the singleton with
+// `r4 = 0x809C0000; FlatWriteRam32(r4 + 7736, r3)`, and SectionMgr::Update
+// (0x8063550C) takes the current Section* from `FlatRead32(r3 + 48)`. Which
+// section id means "racing" is deliberately NOT decided here -- that is measured
+// on the device first.
+#pragma once
+
+#include <cstdint>
+
+namespace VrGameState {
+
+// One reading of the section state. `valid` is false before the game has
+// created its section manager, which is most of the loading screen.
+struct Snapshot {
+    bool valid = false;
+    // What was actually read at the two steps, plausible or not. Kept so a
+    // probe that finds nothing can say WHY instead of just saying nothing.
+    uint32_t rawManager = 0;
+    uint32_t rawSection = 0;
+    bool checkedAccess = false;
+    uint32_t sectionAddress = 0;
+    // The first eight words of the Section object. Which of them carries the
+    // scene id is what the measurement is for; logging a window instead of
+    // guessing an offset costs nothing and cannot be wrong.
+    uint32_t words[8]{};
+
+    bool operator==(const Snapshot& rhs) const noexcept;
+    bool operator!=(const Snapshot& rhs) const noexcept { return !(*this == rhs); }
+};
+
+// Safe to call from any thread and at any time, including before the game has
+// started. A pointer that does not land in guest RAM is reported as invalid
+// rather than followed.
+Snapshot Read() noexcept;
+
+// The section id, which is the Section object's first word.
+uint32_t SectionId(const Snapshot& snapshot) noexcept;
+
+// Whether that id is one the game races in. Measured on the device rather than
+// taken from anywhere: over one run of menu, character select, a full race and
+// back, the ids were 63, 72, 25, 30 and 65, and 30 was the only one that lasted
+// two minutes. The frame rate settles it beyond doubt -- the intro fly-over and
+// the twelve-kart grid, the heaviest ten seconds the game has, begin on the very
+// frame the id turns 30, while 25 sits at a flat 60 and is the load before it.
+//
+// Only that one race was measured, so time trial, battle and online may well use
+// ids that are not in here. An unknown id is therefore treated as NOT racing --
+// the flat screen is the safe answer -- and logged once so the list can grow
+// from evidence instead of from guesses.
+bool IsRacingSection(uint32_t sectionId) noexcept;
+
+// Where the player's kart is, in the game's own units.
+//
+// This is what lets the seat be described without inventing a scale. Asking for
+// "1.5 metres forward" needs a metre, and nothing in a recompiled Wii title says
+// how long one is; asking for "a fraction of the way from the camera to the
+// kart" needs neither, because the game knows both ends itself and keeps them
+// right through every camera move it makes on its own.
+//
+// The chain was read out of the translated code, not guessed:
+//   Kart::Manager::CreateInstance (0x8058FAA8) stores the singleton at 0x809C18F8
+//   Kart::Manager::GetKartPlayer  (0x80590100) is read32(mgr + 32) + index * 4
+//   Kart::Link::GetKartBodyMtx    (0x80590278) is read32(read32(link) + 8) + 28
+// The last is a 3x4 row-major matrix: rotation in the first three columns and
+// the position in the fourth, which is why it is worth more than the position
+// getter next to it -- it says which way the driver is facing as well.
+struct KartPose {
+    bool valid = false;
+    // Row-major 3x4 as the game stores it: [row][column], translation in column 3.
+    float matrix[12]{};
+
+    float x() const noexcept { return matrix[3]; }
+    float y() const noexcept { return matrix[7]; }
+    float z() const noexcept { return matrix[11]; }
+};
+
+// Player 0's kart. Invalid outside a race, which is every section but 30.
+KartPose ReadKartPose() noexcept;
+
+// Where the driver sits, as seen from the game's own camera.
+//
+// This is the whole reason the chain above was worth following. Describing the
+// seat in metres needs a metre, and a recompiled Wii game has none; worse, a
+// value too large moves the eye PAST the kart, and everything the game pins to
+// the kart -- the shake prompt, the warning that someone is coming up behind
+// with a mushroom -- ends up behind the player, where it cannot be seen. A
+// position expressed as a fraction of the way from the camera to the kart
+// cannot do that: at 1 the eye is at the kart and there is no further to go.
+//
+// The vector is in the game's VIEW space, which is where the renderer's own
+// per-eye add-on is applied, so it needs no conversion and no scale. It is
+// computed from the game's view matrix (GameCamera + 4, reached through
+// Kart::Link::SetCamera's slot at +36) applied to the kart's own position.
+struct SeatTarget {
+    bool valid = false;
+    // The kart, in view space: x right, y up, -z forward, game units.
+    float x = 0.0f;
+    float y = 0.0f;
+    float z = 0.0f;
+};
+
+SeatTarget ReadSeatTarget() noexcept;
+
+// Where the driver's eye belongs, in the game's view space, ready to be added to
+// the headset's own offset exactly like ReadSeatTarget's answer was.
+//
+// `height` and `forward` are in the game's units, measured along the KART's own
+// axes, so they mean the same thing on a banked corner as on a straight. The
+// defaults are not a taste: build 45 read the driver's head bone out of the
+// game for a whole race and it sat 54 units above the kart's origin, half a unit
+// to the right of centre and two units behind it, varying by less than six units
+// over the entire lap, corners included. What had been set by hand before that
+// measurement was 94 units -- the eye was floating about forty units above the
+// driver, which is exactly what "die fps kamera ist gar nicht am richtigen
+// platz" looks like from the inside.
+//
+// The bone is NOT read here, and that is the point. Read live it drifts: the
+// driver's matrices and the kart's body matrix are finished at different moments
+// in the game's frame, so the two disagree by an exact number of frames of
+// travel, flickering between none and two. Build 46 proved that is not a torn
+// read by moving the reading onto the guest thread and watching it survive. But
+// a ruler only has to be read once. The number is measured, the kart's body
+// matrix is current, and hanging the one on the other leaves the drift with
+// nowhere to enter.
+//
+// The one thing that still comes from the game every frame is the kart's own
+// matrix, which carries its rotation AND its scale -- so a mega mushroom, which
+// grows the kart, should carry the eye up with it for free. Should: that is a
+// prediction from the shape of the maths, and the device decides it.
+SeatTarget ReadSeatPoint(float height, float forward) noexcept;
+
+// What build 45 measured, and therefore where the dials sit when nobody has
+// touched them.
+inline constexpr float kMeasuredHeadHeight = 54.0f;
+inline constexpr float kMeasuredHeadForward = -2.0f;
+
+// One reading of where the driver's head is, with every step of the walk kept.
+//
+// This exists because the seat as a fraction of the way to the kart missed the
+// driver's place, and it missed it for a reason no amount of turning the dial
+// can fix: the fraction's far end is the kart's ORIGIN, which sits at the bottom
+// of the machine. A driver's head is not there, and saying how far above it is
+// needs a length -- exactly the guess the fraction was introduced to avoid. The
+// game, it turns out, does not have to be asked in metres: it names the driver's
+// bones itself and keeps a matrix for each of them, every frame.
+//
+// Read out of the translated code, not guessed:
+//   Kart::Link::GetDriverController (0x80590A40) is read32(read32(this) + 20),
+//     so the driver hangs off the SAME object this file already walks for the
+//     body and the camera -- one more read, not a new chain.
+//   DriverController::Load fills 36 bone entries of 96 bytes at this + 260, in
+//     the order of the name table at 0x809C3DB8, whose strings sit at 0x808A7288
+//     in the static blob. Read out of the blob rather than inferred from the
+//     sound of it: index 14 is "face_1" and index 15 is "cap1".
+//   Each entry carries its ResNodeData at +24 -- zero when that bone is not in
+//     the loaded model at all -- and its matrix id at +28.
+//   The driver's ModelDirector is at this + 108; its ScnMdlEx is at +20 (the
+//     word at +16 is a COPY of that pointer, not a handle of its own), the tag
+//     at +4 is 0 or 1 for a usable slot, and the first word is the scene model.
+//   The scene model keeps its matrices at +236, 48 bytes apart, indexed by that
+//     matrix id. Not +244 -- those are the view matrices.
+//
+// Two links are read but NOT proven, which is why nothing here is applied to the
+// camera yet and why every step of the walk is kept instead of summarised:
+//   * "face_1" is a joint. A joint of that name is very probably in the head,
+//     but a joint sits at the base of what it drives, so the distance from it up
+//     to an eye is unknown until it has been seen.
+//   * Whether the matrices at +236 hold world space or a parent's space is not
+//     settled anywhere in the code. If it is a parent's space the head point is
+//     wrong, and moving the eye there would put it in the ground.
+// Both are questions one logged line answers, and until it has, the camera stays
+// on the fraction it is on today.
+struct HeadProbe {
+    // True only when the whole walk resolved AND the head could be expressed
+    // relative to the kart. Everything below is filled in as far as the walk
+    // got, so a probe that finds nothing can say WHERE it stopped.
+    bool valid = false;
+
+    uint32_t inner = 0;
+    uint32_t driverController = 0;
+    // read32(dc + 0). DriverController derives from Kart::Link, so this has to
+    // come back as `inner` again; if it does not, the walk has left the object
+    // it thinks it is on and none of the numbers below mean anything.
+    uint32_t selfCheck = 0;
+    uint32_t boneArray = 0;
+    uint32_t headNode = 0;
+    uint32_t headMatrixId = 0;
+    uint32_t capNode = 0;
+    uint32_t capMatrixId = 0;
+    uint32_t modelDirector = 0;
+    uint32_t sceneHandle = 0;
+    uint32_t sceneTag = 0;
+    uint32_t sceneModel = 0;
+    uint32_t matrixArray = 0;
+    // dc + 272. More than the 33 the game names would mean unnamed nodes landed
+    // in the spare slots, so the skeleton is not the one this assumes.
+    uint32_t namedBoneCount = 0;
+
+    // Bone 0, "skl_root": the driver's own skeleton root. It comes out of the
+    // SAME matrix array as the head, which is the whole reason it is read.
+    //
+    // Build 46 moved the reading onto the guest thread and the gap between head
+    // and kart stayed -- still an exact number of frames of travel, still
+    // flickering between none and two. So it was never a torn read: the driver's
+    // matrix array and the kart's body matrix are simply not finished at the same
+    // moment. A difference between two values out of the SAME array cannot have
+    // that problem, whatever the cause, because both ends move together.
+    uint32_t rootNode = 0;
+    uint32_t rootMatrixId = 0;
+    bool rootPointValid = false;
+    float rootWorld[3]{};
+    // The head in the driver's own frame: the root's rotation taken out, so this
+    // is a property of the model and of the pose, and nothing else. If it is
+    // steady at speed, the seat can be built from it and the lag cannot reach it.
+    float headInRoot[3]{};
+    // The root in the kart's frame. This one still mixes the two clocks, so it is
+    // measured rather than used: it says whether the driver's root is bolted to
+    // the kart at a fixed place, and how far the two clocks really drift apart.
+    float rootInKart[3]{};
+
+    bool headPointValid = false;
+    float headWorld[3]{};
+    bool capPointValid = false;
+    float capWorld[3]{};
+    bool kartValid = false;
+    float kartWorld[3]{};
+
+    // The head as the KART sees it: the kart's own rotation taken back out, so x
+    // is right, y is up and z is forward along the machine, in game units. `y`
+    // is the number this whole probe exists for -- how far above the kart's
+    // origin the head bone actually sits -- and taking the rotation out is what
+    // keeps a corner or a ramp from disguising it.
+    bool localValid = false;
+    float headLocal[3]{};
+    float capLocal[3]{};
+
+    // The scene object's world bounding box, six floats at scn + 180. Its upper
+    // edge measured against the head gives what is left between the joint and
+    // the top of the model without anyone having to name a length.
+    bool boxValid = false;
+    float worldBox[6]{};
+
+    // Raw windows, not interpretations. Hiding the driver later needs to know
+    // which word holds the list of his models and which holds its count, and
+    // that is deliberately NOT decided here: the words are logged and read off
+    // the device, the same way the section id was found. Logging a window cannot
+    // be wrong; guessing an offset can.
+    uint32_t modelWords[6]{};  // dc + 104 .. dc + 124
+    uint32_t listWords[9]{};   // dc + 212 .. dc + 244
+
+    // The game's own frame counter when this was taken. Zero in a reading that
+    // was never taken on the guest thread at all.
+    uint32_t guestFrame = 0;
+};
+
+// Player 0's driver, read where the caller stands. Invalid outside a race, like
+// the kart pose.
+//
+// Reading this from a host thread gives a TORN answer and build 45 measured how
+// torn: the head bone and the body matrix came from different game frames, and
+// the gap between them was an exact multiple of one frame's travel -- zero, one
+// or two frames, flickering between them at speed. At full tilt one frame is
+// about 87 game units, so an eye hung on this directly would jump most of two
+// metres backwards and return, for one image at a time. Use SampleHeadProbe and
+// LatestHeadProbe instead; this stays public because it is what they call.
+HeadProbe ReadHeadProbe() noexcept;
+
+// Take one reading ON THE GUEST THREAD and keep it.
+//
+// The one moment where every matrix of a frame is finished and none of them is
+// being rewritten is the end of that frame's drawing, which is why this is
+// called from GXCopyDisp. Reading there cannot tear, because the writer is the
+// caller.
+void SampleHeadProbe() noexcept;
+
+// Take the driver out of the picture, or put him back. GUEST THREAD ONLY.
+//
+// This is the first thing the headset ever writes into the game's own memory,
+// and it is deliberately the smallest write that does the job: two bits in one
+// word per scene object. Read out of the translated code, not guessed:
+//   The gather stage (0x80071120) turns bit 0x20000000 of ScnObj + 204 into
+//   "skip the opaque list" and bit 0x40000000 into "skip the translucent list",
+//   and ScnObjGather::Add then leaves the object out of both. Nothing else in
+//   the game writes those two bits except ScnMdlSimple::Construct and
+//   ScnMdl::Construct through 0x80072A70 -- so a model rebuild clears them and
+//   nothing else does.
+//
+// Two ways of hiding a model were on the table and this is the one that does not
+// break the seat. ModelDirector::ToggleVisible unhooks the node from its scene
+// group, and the group is what drives the CALC stage of its children -- an
+// unhooked driver stops having his bones calculated, and the head the camera is
+// meant to sit on freezes with them. These bits sit in the gather stage only, so
+// everything the game computes about the driver keeps being computed; he is
+// simply not handed to the renderer.
+//
+// Idempotent and cheap, which is why it is called every frame rather than once:
+// a model rebuilt on a respawn comes back visible otherwise. Returns how many
+// scene objects it actually had to change, which is zero on all but the first
+// frame after a rebuild -- a number worth logging, because anything else means
+// something else is fighting for those bits.
+uint32_t SetDriverHidden(bool hidden) noexcept;
+
+// The most recent guest-thread reading. Safe from any thread. `guestFrame` says
+// how old it is; a session thread running faster than the game will see the same
+// frame twice, which is a great deal better than seeing half of two.
+HeadProbe LatestHeadProbe() noexcept;
+
+} // namespace VrGameState
diff --git a/runtime/src/vr/vr_pad.cpp b/runtime/src/vr/vr_pad.cpp
new file mode 100644
index 0000000..a167724
--- /dev/null
+++ b/runtime/src/vr/vr_pad.cpp
@@ -0,0 +1,304 @@
+#include "vr_pad.h"
+
+#include "runtime_log.h"
+#include "settings_overlay.h"
+#include "vr/vr_session.h"
+
+#include <dolphin/pad.h>
+
+#include <algorithm>
+#include <cmath>
+
+// runtime_log.h owns the canonical tag list and this module must not edit that
+// header, so the tag lives here behind a guard, exactly as vr_session.cpp does.
+#ifndef RT_TAG_VR
+#define RT_TAG_VR "vr"
+#endif
+
+namespace VrPad {
+namespace {
+
+// The GameCube pad's ranges, read out of aurora's PAD layer rather than assumed
+// (aurora-main/include/dolphin/pad.h and lib/dolphin/pad/pad.cpp):
+//
+//   stickX/stickY/substickX/substickY  s8. Aurora fills them with the SDL axis
+//       divided by 256, so a real pad reaches +-127 and rests at 0, +y up.
+//   triggerLeft/triggerRight           u8. SDL's 0..32767 pull divided by 128,
+//       so a real pad reaches 255.
+//   button                             u16 of PAD_BUTTON_* / PAD_TRIGGER_* bits.
+//   err                                PAD_ERR_NONE for a port with a pad in it,
+//       PAD_ERR_NO_CONTROLLER for an empty one.
+//
+// These are the RAW ranges. The game applies the SDK's own clamp region on top
+// (min 15 / max 72 on the stick, min 30 / max 180 on the triggers), and it does
+// that to a real pad's numbers as well -- so feeding the same raw range is what
+// makes a Touch stick and an Xbox stick steer by the same amount. Scaling to 72
+// here to "match the clamp" would halve the steering twice over.
+constexpr int kStickFullScale = 127;
+constexpr int kTriggerFullScale = 255;
+
+// Where an analog pull becomes a button press. Half the travel, and deliberately
+// earlier than either of the two thresholds already in the chain: aurora turns an
+// Xbox trigger into PAD_TRIGGER_L/R only past 31150 of 32767 (about 95%), and the
+// game itself does the same from the analog byte only at the very top of its own
+// clamp range. Both of those numbers exist for a pad with long, soft travel; a
+// Touch trigger is short and stiff, and holding it bottomed out for a whole race
+// is a cramp. The analog byte is filled proportionally alongside the bit, exactly
+// as a real pad's is, so nothing that reads the pull instead of the click is left
+// disagreeing with the bit.
+constexpr float kPressThreshold = 0.5f;
+
+// How far the right thumbstick has to go before it counts as a D-pad direction.
+// Higher than a steering dead zone on purpose: this stick is a discrete input,
+// and a trick fired by a resting thumb costs a landing.
+constexpr float kHatThreshold = 0.6f;
+
+int8_t StickByte(float value) {
+    const float clamped = std::clamp(value, -1.0f, 1.0f);
+    const long scaled = std::lround(clamped * static_cast<float>(kStickFullScale));
+    return static_cast<int8_t>(std::clamp(scaled, -static_cast<long>(kStickFullScale),
+                                          static_cast<long>(kStickFullScale)));
+}
+
+uint8_t TriggerByte(float value) {
+    const float clamped = std::clamp(value, 0.0f, 1.0f);
+    const long scaled = std::lround(clamped * static_cast<float>(kTriggerFullScale));
+    return static_cast<uint8_t>(std::clamp(scaled, 0L, static_cast<long>(kTriggerFullScale)));
+}
+
+// Squared distance of a stick from its centre. Squared because it is only ever
+// compared against another one, and a square root per frame per axis buys
+// nothing.
+int32_t StickDistanceSquared(int x, int y) {
+    return static_cast<int32_t>(x) * x + static_cast<int32_t>(y) * y;
+}
+
+// Which port the Touch controllers feed.
+//
+// -1 in the snapshot means "the first port nothing else is using", and that is
+// the default for one concrete reason: two sources writing one port is worse
+// than either source alone. With no pad connected the Touch controllers land on
+// port 0, which is the port a single-player game reads. With a pad connected,
+// aurora has already claimed port 0 and the Touch controllers move to port 1 --
+// where this game will not read them, so the pad keeps the race to itself and
+// nothing fights over the steering. That is the intended outcome: a plugged-in
+// pad wins, silently and completely.
+//
+// A configured port is honoured even when a real pad is already there, because
+// somebody who names a port has a reason to and only they can see both devices.
+// Returns -1 when there is no port to write.
+int ChoosePort(const Vr::ControllerState& state, const PADStatus* statuses, uint32_t count) {
+    if (state.port >= 0) {
+        return static_cast<uint32_t>(state.port) < count ? state.port : -1;
+    }
+    for (uint32_t port = 0; port < count; ++port) {
+        if (statuses[port].err != PAD_ERR_NONE) {
+            return static_cast<int>(port);
+        }
+    }
+    return -1;
+}
+
+} // namespace
+
+// The mapping. Which GameCube bit does what was READ OUT OF THE GAME rather than
+// taken from a controls page: Input::GCNController::UpdateImpl reduces the four
+// PADStatus button groups below to four separate race inputs, and it is not the
+// grouping a GameCube layout diagram suggests --
+//
+//   PAD_BUTTON_A                                      -> one input, on its own
+//   PAD_BUTTON_B or PAD_TRIGGER_R  (one mask, 0x220)  -> a second, plus a third
+//                                                        that only appears when A
+//                                                        is held and one of the
+//                                                        two is newly pressed
+//   PAD_TRIGGER_L                  (0x40)             -> a fourth, on its own
+//   PAD_BUTTON_X or PAD_TRIGGER_Z  (one mask, 0x410)  -> a fifth
+//   the four D-pad bits, newly pressed                -> a direction 1..4 written
+//                                                        to the trick field, with
+//                                                        left and right swapped
+//                                                        under the mirror flag
+//
+// PAD_BUTTON_Y is never read at all, and B is grouped with R rather than with L.
+// So putting two of our controls on B and R would have driven ONE race input
+// from two different fingers and left the input behind L unreachable for the
+// whole build -- which looks exactly like "the brake does not work" and is the
+// concrete mistake this comment exists to prevent.
+//
+// Which of those inputs is which was finally settled by PLAYING a race, not by
+// reading. The first attempt named them from a GameCube layout diagram and got
+// two of them backwards: the item turned out to be on L and "look behind" on the
+// X/Z mask, not the other way round. The layout below is the measured one.
+//
+//   left thumbstick   -> stickX/stickY     steering, and menu navigation
+//   right trigger     -> A                 accelerate; confirm in the menus
+//   left trigger      -> R (+ analog)      brake, reverse, and the drift hop
+//   either grip       -> D-pad up          trick, on a button that can be hit
+//                                          on a beat (the POW block)
+//   right A / right B -> L (+ analog)      fire an item
+//   left X / left Y   -> X                 look behind; cancel in the menus.
+//                                          Never Y, which this game ignores
+//   left menu button  -> Start             pause, on a SHORT press only
+//   right thumbstick  -> D-pad             the trick direction, and only that
+//
+// Brake and drift sharing one control is the game's design, not a compromise
+// here: with the throttle held, a new press is a hop; without it, the same press
+// brakes and then reverses. No mapping can separate them, because the game never
+// looks at which of B or R was pressed.
+//
+// The D-pad line is not a convenience. That direction field is written from the
+// D-pad and from nothing else, and a pair of Touch controllers has no D-pad at
+// all -- so without the right thumbstick standing in for one, the trick is
+// unreachable for the entire build and every ramp in the game is worth less than
+// it should be. It is read as one direction at a time (whichever axis is further
+// out wins), so a sloppy diagonal cannot press two of them at once.
+void MergeIntoPadStatuses(PADStatus* statuses, uint32_t count) noexcept {
+    if (statuses == nullptr || count == 0) {
+        return;
+    }
+    const Vr::ControllerState state = Vr::CurrentControllers();
+    if (!state.connected) {
+        // The proof that a pad-only player notices nothing: every return above
+        // this line and this one leave `statuses` exactly as aurora built it,
+        // and `connected` is false unless an OpenXR session has really had a
+        // controller answer at least once.
+        return;
+    }
+    // The overlay takes the input for itself, and this has to be asked HERE:
+    // PADBlockInput reaches only aurora's own sources, which are neutralised
+    // before this function ever runs, so without the test the thumbstick moving
+    // through the menu would steer the kart behind it. Treated exactly like a
+    // controller that is connected but silent -- the port keeps existing, so the
+    // game does not decide the pad was unplugged while a menu is open.
+    const bool blocked = settings_overlay::InputBlocked();
+
+    // Note what is NOT tested here. A controller that is connected but not
+    // currently delivering -- the app is unfocused, the player pressed the Meta
+    // button, the headset is off the head -- still claims its port and still
+    // reports a connected pad, only with every input at rest. Returning here
+    // instead would make the port empty for those frames, and the game would
+    // decide the controller had been unplugged in the middle of a race.
+    const bool delivering = state.delivering && !blocked;
+    const int port = ChoosePort(state, statuses, count);
+    if (port < 0) {
+        static bool loggedFullPorts = false;
+        if (!loggedFullPorts) {
+            loggedFullPorts = true;
+            RT_LOGF(RT_TAG_VR, "input: every pad port is taken; the Touch controllers stay unused\n");
+        }
+        return;
+    }
+    PADStatus& status = statuses[port];
+    if (status.err != PAD_ERR_NONE) {
+        // An empty port is reported by aurora as PAD_ERR_NO_CONTROLLER with the
+        // rest of the struct zeroed. Turning it into a connected pad is the
+        // whole point of the port being empty -- without this the game sees no
+        // controller and will not even let Start be pressed.
+        status = PADStatus{};
+        status.err = PAD_ERR_NONE;
+    }
+
+    if (!delivering) {
+        // Connected but silent. The port above is claimed and reports a pad, and
+        // nothing else is written: every input stays where aurora left it, which
+        // for a claimed empty port is the neutral state set just above. A button
+        // that was held when focus was lost must not stay held while the player
+        // is in the system menu.
+        return;
+    }
+
+    uint16_t buttons = 0;
+    if (state.accelerate >= kPressThreshold || state.select) {
+        buttons |= static_cast<uint16_t>(PAD_BUTTON_A);
+    }
+    if (state.brake >= kPressThreshold) {
+        // R, the same input the grips drive, and deliberately so. Braking,
+        // reversing and the drift hop are ONE thing in this game: B and R are a
+        // single mask (0x220), and which of the three you get is decided by the
+        // throttle, not by the button -- held with A it hops, without A it brakes
+        // and then reverses. So the left trigger is not a second control here,
+        // it is a second way to reach the one control, which is what a racing
+        // game's left trigger is for.
+        //
+        // BOTH bits, and B is the one that matters outside a race. The race path
+        // reads B and R as a single mask, so in a race setting both says exactly
+        // what setting either one said. The MENUS do not go through that path --
+        // they read B itself for "back", and with only R set there was no way
+        // out of a menu at all. Found by playing, after a build where every
+        // other control was right and nothing could be cancelled.
+        buttons |= static_cast<uint16_t>(PAD_TRIGGER_R) | static_cast<uint16_t>(PAD_BUTTON_B);
+    }
+    if (state.item) {
+        // L, which is what actually fires an item. Measured in a race rather
+        // than read off a layout diagram: the first guess had the item on X and
+        // the brake on L, and one lap settled both the other way round.
+        buttons |= static_cast<uint16_t>(PAD_TRIGGER_L);
+    }
+    if (state.back) {
+        // X, "look behind" in a race and cancel in the menus. It shares its mask
+        // with Z (0x410) and drives nothing else, so it is the one input free to
+        // sit on a face button without colliding with driving.
+        buttons |= static_cast<uint16_t>(PAD_BUTTON_X);
+    }
+    if (state.menu) {
+        // Not the raw button. The one menu button a pair of Touch controllers
+        // has is shared with the settings overlay, so the session sets this only
+        // after the button has come back up inside the long-press threshold, and
+        // holds it for a fixed span so this game's own edge detector cannot miss
+        // it between two of its 60 Hz reads. A press held past the threshold
+        // opens the overlay and never reaches here, which is what stops the way
+        // in to the settings from also pausing the race on the way.
+        buttons |= static_cast<uint16_t>(PAD_BUTTON_START);
+    }
+    if (state.drift >= kPressThreshold) {
+        // The grips are the TRICK button, not a second brake. A trick is a D-pad
+        // edge and nothing else, and there are moments where it has to be hit
+        // exactly -- a POW block about to land is the one everybody knows -- so
+        // it belongs under a finger that is already curled around the grip, not
+        // on a thumbstick that has to be found and flicked. Braking, reversing
+        // and the drift hop all stay reachable on the left trigger, which is the
+        // same game input either way, so nothing is lost by moving these.
+        //
+        // Up, because the direction only chooses which trick animation plays;
+        // any of the four counts as a trick.
+        buttons |= static_cast<uint16_t>(PAD_BUTTON_UP);
+    }
+    const float trickX = std::fabs(state.trickX);
+    const float trickY = std::fabs(state.trickY);
+    if (trickX >= kHatThreshold || trickY >= kHatThreshold) {
+        if (trickX > trickY) {
+            buttons |= static_cast<uint16_t>(state.trickX > 0.0f ? PAD_BUTTON_RIGHT : PAD_BUTTON_LEFT);
+        } else {
+            buttons |= static_cast<uint16_t>(state.trickY > 0.0f ? PAD_BUTTON_UP : PAD_BUTTON_DOWN);
+        }
+    }
+    // OR, never assign: on a port a real pad already holds, a button one source
+    // presses stays pressed whatever the other source is doing.
+    status.button = static_cast<uint16_t>(status.button | buttons);
+
+    const int8_t stickX = StickByte(state.steerX);
+    const int8_t stickY = StickByte(state.steerY);
+    // A stick cannot be OR-ed, so the source further from centre wins the whole
+    // vector. Blending or summing them would let a resting pad drag a full-lock
+    // Touch input back towards the middle, which is exactly the fight this is
+    // meant to avoid; and a stick at rest never takes the other source's over.
+    if (StickDistanceSquared(stickX, stickY) > StickDistanceSquared(status.stickX, status.stickY)) {
+        status.stickX = stickX;
+        status.stickY = stickY;
+    }
+    // Both analog bytes, alongside the two bits above. The game turns a trigger
+    // byte at the top of its clamp range into PAD_TRIGGER_L/R itself, so leaving
+    // these at zero would have the byte and the bit contradicting each other on
+    // a port that a real pad also writes.
+    //
+    // The substick is left alone on purpose: this game's GameCube path never
+    // reads it, and the right thumbstick is already spoken for as the D-pad.
+    // L carries the item, which is a face button and therefore all or nothing.
+    // R carries brake, reverse and the drift hop, and only the left trigger
+    // drives it now -- the grips moved to the trick, which is a D-pad bit and
+    // has no analog side at all.
+    status.triggerLeft =
+        std::max<uint8_t>(status.triggerLeft, state.item ? uint8_t{255} : uint8_t{0});
+    status.triggerRight = std::max<uint8_t>(status.triggerRight, TriggerByte(state.brake));
+}
+
+} // namespace VrPad
diff --git a/runtime/src/vr/vr_pad.h b/runtime/src/vr/vr_pad.h
new file mode 100644
index 0000000..2776a13
--- /dev/null
+++ b/runtime/src/vr/vr_pad.h
@@ -0,0 +1,30 @@
+// The Quest's own Touch controllers as a GameCube pad.
+//
+// This is the second half of the controller path: vr/vr_session.cpp owns the
+// OpenXR action set and publishes a Vr::ControllerState once per headset frame,
+// and this turns that snapshot into a contribution to one PADStatus on the
+// guest's PAD path. The split is deliberate -- nothing in here knows about
+// OpenXR, and nothing in the session knows what a GameCube button bit is.
+//
+// The one rule that outranks everything else here: when no Touch controller is
+// delivering input, the statuses must come out byte-identical to what aurora
+// built. Somebody racing with a pad plugged in has to be unable to tell that
+// this file exists.
+#pragma once
+
+#include <cstdint>
+
+struct PADStatus;
+
+namespace VrPad {
+
+// Merges the last published Touch state into one of `count` GameCube pad
+// statuses. Call it from PAD__Read_HLE after every other source has had its
+// say, on the guest thread; it never blocks and never calls into OpenXR.
+//
+// Returns without touching a single byte when the session is not delivering:
+// no OpenXR session, mode panel, vr.controllers = false, the app not focused,
+// or no interaction profile bound any of our paths.
+void MergeIntoPadStatuses(PADStatus* statuses, uint32_t count) noexcept;
+
+} // namespace VrPad
