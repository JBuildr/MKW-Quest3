@@ -89,6 +89,14 @@ elseif(MKW_PLATFORM_LINUX)
     # media monitoring). Empty string on glibc >= 2.34 where dl* is in libc.
     target_link_libraries(mkw_runtime_common PRIVATE mkw::libco ${CMAKE_DL_LIBS})
 endif()
+if(MKW_PLATFORM_ANDROID)
+    # This edge is here for the headers: runtime/src/vr includes
+    # <openxr/openxr.h>, and the loader target's interface is what carries the
+    # OpenXR include directory (upstream attaches it through OpenXR::headers).
+    # The link edge on the products is a separate one further down - an OBJECT
+    # library hands its consumer objects, not its link libraries.
+    target_link_libraries(mkw_runtime_common PRIVATE OpenXR::openxr_loader)
+endif()
 if(MKW_CPPWINRT_INCLUDE_DIR)
     if(NOT EXISTS "${MKW_CPPWINRT_INCLUDE_DIR}/winrt/base.h")
         message(FATAL_ERROR
@@ -104,6 +112,14 @@ foreach(source IN LISTS SOURCES)
     string(REPLACE "\\" "/" source_normalized "${source}")
     if(source_normalized MATCHES "/hle/gx/")
         set(runtime_group "gx_bridge")
+    elseif(source_normalized MATCHES "/src/vr/")
+        # The OpenXR sources are the only ones compiled against
+        # <openxr/openxr_platform.h> with XR_USE_PLATFORM_ANDROID, which pulls in
+        # jni.h and the platform structs. Without a branch of their own they fall
+        # into the hashed buckets below and get merged with whatever unrelated
+        # runtime TU shares a bucket, which is how a unity build turns one file's
+        # platform macros into every other file's problem.
+        set(runtime_group "vr")
     elseif(source_name MATCHES "network|socket|dns|dwc|ios")
         set(runtime_group "network_ios")
     elseif(source_name MATCHES "os_|system|memory|fiber|scheduler")
@@ -250,6 +266,13 @@ function(mkw_configure_product target)
         set(MKW_ANDROID_EXPORT_MAP "${MKW_RUNTIME_SOURCE_DIR}/cmake/android_exports.map")
         target_link_options(${target} PRIVATE "-Wl,--version-script=${MKW_ANDROID_EXPORT_MAP}")
         set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${MKW_ANDROID_EXPORT_MAP}")
+        # The xr* calls live in mkw_runtime_common's objects, which arrive here
+        # as plain .o files, so the product link needs the loader itself - the
+        # same reason mkw::libco is repeated in the branch above. It is a shared
+        # library, so this is a DT_NEEDED on libopenxr_loader.so and the
+        # packaging step has to put that .so in the APK (MKW_OPENXR_LOADER_SO in
+        # the cache says where the build left it).
+        target_link_libraries(${target} PRIVATE OpenXR::openxr_loader)
     endif()
     if(MKW_PLATFORM_WINDOWS)
         foreach(runtime_dll libc++.dll libunwind.dll)
diff --git a/runtime/include/aurora_events.h b/runtime/include/aurora_events.h
index 546757f..5bba023 100644
--- a/runtime/include/aurora_events.h
+++ b/runtime/include/aurora_events.h
@@ -152,5 +152,14 @@ inline void UpdateAuroraAndProcessEvents() {
         return;
     }
 #endif
+    // Past the gate above, and only past it, this is the scheduler/retrace
+    // context. That is exactly the property the settings overlay needs, so the
+    // long-press request the OpenXR thread raises is taken here rather than at
+    // the point where it is set: the OpenXR thread is not a guest fiber, but it
+    // is not the scheduler context either, and anything it drove into ImGui or
+    // SDL would land in the same ART abort this gate exists to prevent. This is
+    // already the runtime's per-frame poll, so nothing new runs and no new
+    // thread or callback is introduced.
+    settings_overlay::PollVrSettingsRequest();
     ProcessAuroraEvents(aurora_update());
 }
