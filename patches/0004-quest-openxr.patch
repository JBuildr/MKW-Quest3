+# ----------------------------------------------------------------------
+# Third-party: OpenXR loader (Quest only)
+# ----------------------------------------------------------------------
+# Android is the only platform with a headset to reach, so the whole OpenXR
+# dependency either lives here or does not exist at all. The src/*.cpp glob
+# further down is platform-independent, so runtime/src/vr is compiled on every
+# platform while the loader target exists on none of the others: what those
+# sources do with OpenXR belongs behind their own Android guard, and
+# Vr::Start() failing is a supported outcome (runtime/include/vr/vr_session.h).
+#
+# Position matters: this is the last third-party tree added, and it is added
+# while the directory scope still carries nothing but the flags the vendored
+# trees above got. The project-wide definitions and -fvisibility=hidden below
+# seed every target created after them, and the loader is upstream code we do
+# not compile on our own terms -- it sets its own visibility preset and marks
+# its xr* entry points visible one by one, and the shared library it produces is
+# the APK's only way into the runtime. Keeping it above that line is the same
+# rule the aurora block follows, for the same reason.
+if(MKW_PLATFORM_ANDROID)
+    include("${CMAKE_CURRENT_LIST_DIR}/cmake/OpenXRLoader.cmake")
+endif()
+
 # Everything from here down is this project's own code, so this is where the
 # project definitions enter the directory scope. A directory-scoped definition
 # seeds the COMPILE_DEFINITIONS of targets as they are created, which means:
diff --git a/runtime/cmake/OpenXRLoader.cmake b/runtime/cmake/OpenXRLoader.cmake
new file mode 100644
index 0000000..699408f
--- /dev/null
+++ b/runtime/cmake/OpenXRLoader.cmake
@@ -0,0 +1,104 @@
+# OpenXR loader for the Quest build (Khronos OpenXR-SDK, Apache-2.0).
+#
+# Horizon OS does not hand out its OpenXR runtime as something to link against:
+# the loader finds the runtime at run time through the Android broker, so an
+# immersive APK has to carry libopenxr_loader.so of its own next to libmain.so.
+#
+# It is built here from a pinned source archive instead of being unpacked from
+# the published .aar, so the loader comes out of the same NDK, sysroot and
+# Release flags as everything else in the APK; a prebuilt .so would be a second
+# toolchain to keep in step with the one this build deliberately fixes. The
+# digest is pinned for the reason every other fetched archive here is: a cached
+# extraction is never verified again, so the check has to happen on the one
+# download.
+#
+# With FETCHCONTENT_FULLY_DISCONNECTED nothing is downloaded, so the source tree
+# has to be present already - either from an earlier connected configure of the
+# same build directory, or pointed at with FETCHCONTENT_SOURCE_DIR_OPENXR_SDK.
+# The digest is then not re-checked; that is FetchContent's documented behaviour
+# and is already the case for every other fetched dependency of this build.
+
+include(FetchContent)
+
+set(MKW_OPENXR_SDK_TAG "release-1.1.63")
+
+# Only the loader is wanted. The -SDK archive does not even contain the
+# api_layers, tests, conformance and hello_xr trees, so upstream never declares
+# their options (each option() in src/CMakeLists.txt is guarded by an EXISTS
+# check). They are pinned anyway: these are plain unprefixed cache names that
+# something else in the same build tree may already have set.
+set(BUILD_LOADER ON CACHE BOOL "" FORCE)
+set(BUILD_ALL_EXTENSIONS OFF CACHE BOOL "" FORCE)
+set(BUILD_API_LAYERS OFF CACHE BOOL "" FORCE)
+set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(BUILD_CONFORMANCE_TESTS OFF CACHE BOOL "" FORCE)
+set(BUILD_SDK_TESTS OFF CACHE BOOL "" FORCE)
+
+# The archive ships the pre-generated dispatch tables, xr_generated_loader.* and
+# the openxr/*.h headers. Forcing regeneration would make a working Python 3 and
+# the specification scripts a build requirement for output that is already in
+# the tarball.
+set(BUILD_FORCE_GENERATION OFF CACHE BOOL "" FORCE)
+
+# DYNAMIC_LOADER is what decides SHARED versus STATIC in
+# src/loader/CMakeLists.txt, and upstream already defaults it ON everywhere
+# except Windows - so Android gets the shared loader without us asking. It is
+# pinned because the shared loader is the only shape the rest of this stage is
+# written for: the APK ships the .so, and the loader's own version script
+# (openxr-loader.map) is what publishes the xr* entry points out of it.
+set(DYNAMIC_LOADER ON CACHE BOOL "" FORCE)
+
+# The loader's Android broker query goes through jnipp, which throws; upstream's
+# own TODO in src/loader/CMakeLists.txt says -fno-exceptions cannot be turned on
+# for it yet. This project compiles with neither -fno-exceptions nor -fno-rtti
+# (the loader adds -fno-rtti to its own sources itself), so the loader keeps its
+# default here and nothing has to be re-enabled for the target.
+set(BUILD_LOADER_WITH_EXCEPTION_HANDLING ON CACHE BOOL "" FORCE)
+
+# Always the vendored jsoncpp. Whether a system jsoncpp happens to be findable
+# on the build machine must not decide what ends up inside the shipped .so.
+set(BUILD_WITH_SYSTEM_JSONCPP OFF CACHE BOOL "" FORCE)
+
+# Nothing is installed out of this build; packaging copies the files it wants.
+# The prefab layout this option selects also parses the NDK's source.properties
+# and fails the configure outright when no major version can be read from it.
+set(INSTALL_TO_ARCHITECTURE_PREFIXES OFF CACHE BOOL "" FORCE)
+
+FetchContent_Declare(openxr_sdk
+    URL https://github.com/KhronosGroup/OpenXR-SDK/archive/refs/tags/${MKW_OPENXR_SDK_TAG}.tar.gz
+    URL_HASH SHA256=5b8dac0608f49498fe8e95f562fe6bcf0bc781e561f137348a8c251d06a88b6f
+    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
+    EXCLUDE_FROM_ALL
+)
+FetchContent_MakeAvailable(openxr_sdk)
+
+# OpenXR::openxr_loader is upstream's own alias for the loader target, and it is
+# the same name a find_package(OpenXR) would provide, so consumers read the same
+# either way. Its interface carries OpenXR::headers, which is where
+# <openxr/openxr.h> comes from.
+if(NOT TARGET OpenXR::openxr_loader)
+    message(FATAL_ERROR "Failed to make the OpenXR loader available")
+endif()
+
+# The packaging step copies the loader into the APK beside libmain.so and reads
+# where it is from the CMake cache. A cache entry holds text, so a generator
+# expression like $<TARGET_FILE:openxr_loader> would be stored verbatim and
+# never expanded: the directory and the file name are resolved here instead. The
+# loader sets no output directory of its own, so the .so lands in its own binary
+# directory, and only the Linux branch of its CMakeLists gives it a SOVERSION -
+# on Android the name is the plain libopenxr_loader.so.
+get_target_property(_mkw_openxr_loader_dir openxr_loader LIBRARY_OUTPUT_DIRECTORY)
+if(NOT _mkw_openxr_loader_dir)
+    get_target_property(_mkw_openxr_loader_dir openxr_loader BINARY_DIR)
+endif()
+get_target_property(_mkw_openxr_loader_name openxr_loader OUTPUT_NAME)
+if(NOT _mkw_openxr_loader_name)
+    set(_mkw_openxr_loader_name openxr_loader)
+endif()
+set(MKW_OPENXR_LOADER_SO
+    "${_mkw_openxr_loader_dir}/${CMAKE_SHARED_LIBRARY_PREFIX}${_mkw_openxr_loader_name}${CMAKE_SHARED_LIBRARY_SUFFIX}"
+    CACHE FILEPATH "OpenXR loader shared library the APK has to ship" FORCE)
+unset(_mkw_openxr_loader_dir)
+unset(_mkw_openxr_loader_name)
+
+message(STATUS "OpenXR loader ${MKW_OPENXR_SDK_TAG}: building the shared loader from source")
