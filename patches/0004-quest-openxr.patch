+// Radial dead zone: the stick is dead inside a circle of `deadzone`, and what is
+// left of the travel is rescaled back out to a full 1.0 so that full lock is
+// still full lock. Doing it per axis instead lets the diagonals reach further
+// than the cardinals, which in a racing game means the steering angle depends on
+// how far up the stick happens to be pushed.
+void ApplyDeadzone(float deadzone, float& x, float& y) {
+    const float limit = std::clamp(deadzone, 0.0f, 0.9f);
+    const float length = std::sqrt(x * x + y * y);
+    if (length <= limit || length <= 0.0f) {
+        x = 0.0f;
+        y = 0.0f;
+        return;
+    }
+    // The second term clamps to the unit circle: a runtime may report a
+    // magnitude a little over 1 on a diagonal, and a signed stick byte built
+    // from that would wrap to the opposite lock instead of saturating.
+    const float scale = std::min((length - limit) / ((1.0f - limit) * length), 1.0f / length);
+    x *= scale;
+    y *= scale;
+}
