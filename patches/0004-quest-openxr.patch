+// A sync-file descriptor waited on by this thread instead of by the GPU. It is
+// the fallback for a device without VK_KHR_external_semaphore_fd and it costs
+// real latency, which is why the per-second line counts it separately.
+bool WaitOnSyncFdBlocking(int fd, int timeoutMs) {
+    pollfd entry{};
+    entry.fd = fd;
+    entry.events = POLLIN;
+    for (;;) {
+        const int ready = ::poll(&entry, 1, timeoutMs);
+        if (ready < 0 && errno == EINTR) {
+            // A signal, not a failure of the fence. Android delivers these
+            // freely and treating one as a timeout would tear the frame.
+            continue;
+        }
+        return ready > 0;
+    }
+}
