+    Log.error("Failed to end access on shared frame buffer {}", hardwareBuffer);
+    return {-1, kVkImageLayoutUndefined};
+  }
+  int syncFd = -1;
+  for (size_t i = 0; i < endState.fenceCount; ++i) {
+    const int exported = duplicate_exported_sync_fd(endState.fences[i]);
+    if (exported < 0) {
+      continue;
+    }
+    if (syncFd < 0) {
+      syncFd = exported;
+      continue;
+    }
+    // Dawn reports one fence per submission that touched the texture and the bridge can only wait
+    // on a single descriptor. A merged sync file signals when all of its fences do, so merge rather
+    // than choose: waiting on only the first would let the session read a half-drawn frame.
