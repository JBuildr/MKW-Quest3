+// The four callbacks below are the only code in this file that runs on aurora's
+// presenter thread. Between them they touch g_bridgeWanted and the ring, and
+// nothing else -- no OpenXR, no Vulkan, no logging in the steady state.
+bool BridgeWantsFrames() {
+    return g_bridgeWanted.load(std::memory_order_acquire);
+}
+
+bool BridgeAcquireTarget(AuroraXrFrameTarget* out) {
+    if (out == nullptr || !g_bridgeWanted.load(std::memory_order_acquire)) {
+        return false;
+    }
+    const std::lock_guard<std::mutex> lock(g_ring.mutex);
+    for (SharedFrame& frame : g_ring.frames) {
+        if (frame.state != SharedFrame::State::Free) {
+            continue;
+        }
+        frame.state = SharedFrame::State::WithAurora;
+        out->hardwareBuffer = frame.buffer;
+        out->width = g_ring.width;
+        out->height = g_ring.height;
+        return true;
+    }
+    // The ring is full because the session thread has not caught up: aurora is
+    // producing faster than 72 Hz, or a frame is still on screen. That is the
+    // back pressure the contract asks for and not a fault, so it is counted for
+    // the per-second line and deliberately not logged.
+    ++g_ring.rejectedCount;
+    return false;
+}
+
+void BridgeSubmitTarget(void* hardwareBuffer, int syncFd, int32_t vkImageLayout) {
+    {
+        const std::lock_guard<std::mutex> lock(g_ring.mutex);
+        for (SharedFrame& frame : g_ring.frames) {
+            if (frame.buffer != hardwareBuffer) {
+                continue;
+            }
+            if (frame.state != SharedFrame::State::WithAurora) {
+                // Submitted twice, or submitted after the bridge took the buffer
+                // back. Falling through closes the descriptor below, which is
+                // the whole of what the bridge owes for it.
+                break;
+            }
+            frame.syncFd = syncFd;
+            frame.layout = static_cast<VkImageLayout>(vkImageLayout);
+            frame.sequence = g_ring.nextSequence++;
+            frame.state = SharedFrame::State::Ready;
+            ++g_ring.arrivedCount;
+            return;
+        }
+    }
+    if (syncFd >= 0) {
+        // Ownership passed to the bridge with the call, and a descriptor leaked
+        // here would end the app with EMFILE after a few minutes rather than
+        // with anything that names this line.
+        ::close(syncFd);
+    }
+}
