diff --git a/aurora-main/include/aurora/stereo.h b/aurora-main/include/aurora/stereo.h
new file mode 100644
index 0000000..5f1a393
--- /dev/null
+++ b/aurora-main/include/aurora/stereo.h
@@ -0,0 +1,90 @@
+// Rendering the game through the headset's own optics.
+//
+// Cinema draws the finished picture onto a screen standing in the room: the game
+// keeps its own camera and its own field of view, and the headset only decides
+// where that screen hangs. This is the other thing -- the game is rendered AS IF
+// the player's eye were the camera, so the world fills the view and turning the
+// head turns the view.
+//
+// Two matrices do that, and they are separate on purpose:
+//
+//   view  is inserted BETWEEN the game's model-view and its projection. The
+//         game's camera stays exactly where the game put it; this only adds what
+//         the head is doing relative to it, plus (later) the offset of one eye.
+//         The game's own camera logic, its HUD placement and its culling are all
+//         untouched, which is why this is an add-on and not a replacement.
+//
+//   proj  REPLACES the game's projection, but only for perspective draws. It has
+//         to: the field of view that matters in a headset is the headset's, not
+//         the one the game chose for a television. Orthographic draws (the HUD,
+//         the menus) keep their own projection and never see either matrix, so
+//         they stay flat and readable.
+//
+// Both are column-major, the same layout Mat4x4<float> already has, and both are
+// applied with the row-vector convention the shader uses everywhere else
+// (clip = v * view * proj).
+//
+// UNITS. The view matrix is built in the GAME's units, not in metres. Nothing in
+// a recompiled Wii game says how long a metre is, so the caller converts using a
+// scale it can tune, and getting it wrong does not look broken -- it looks like
+// the player is the wrong size. That is a setting to be measured on the device,
+// not a constant to be guessed here.
+//
+// STALENESS is expected and fine. The headset predicts where the eyes will be
+// when a frame is finally shown, but the game renders ahead of that, so these
+// matrices are always a little old by the time the picture appears. The
+// compositor's own reprojection covers the difference -- that is what it is for.
+// Do not try to fix this by blocking the renderer on the headset.
+#ifndef AURORA_STEREO_H
+#define AURORA_STEREO_H
+
+#ifdef __cplusplus
+#include <cstdint>
+
+extern "C" {
+#else
+#include "stdbool.h"
+#include "stdint.h"
+#endif
+
+typedef struct {
+  // Inserted between the game's model-view and the projection below.
+  float view[16];
+  // Replaces the game's projection on perspective draws. Built from the
+  // headset's asymmetric field of view and the near and far planes taken from
+  // the game's own projection, so depth precision and clipping stay as the game
+  // intended them.
+  float proj[16];
+  // The game's 2D layer, in x and y only.
+  //
+  // hudScale pulls the layer towards the centre of the view: an orthographic
+  // projection maps the game's screen space onto the whole picture, and in a
+  // headset the picture is the whole field of view, so the lap counter ends up
+  // where nobody reads it. hudOffsetY then slides it up or down in the same
+  // clip space, which is what a pause screen sitting too low needs.
+  //
+  // The layer's DEPTH is deliberately not touched. An earlier attempt put the
+  // whole layer on a plane in front of the eye, which also squeezed every
+  // orthographic z into one sliver; elements that had been cleanly stacked began
+  // fighting for the same depth, and the game lost the other racers from its
+  // minimap and the text from its pause screen. A flat overlay is ordered by the
+  // depth the game gave it, and that ordering belongs to the game.
+  //
+  // A scale of 1 with no offset means "leave the 2D layer exactly as drawn".
+  float hudScale;
+  float hudOffsetY;
+} AuroraStereoView;
+
+// Installs the view for the frames aurora is about to record, or clears it with
+// NULL so every draw goes back to the game's own camera and projection.
+//
+// Thread safety: called from the OpenXR thread while aurora records on the game
+// thread, so the implementation publishes it atomically and each frame uses one
+// consistent pair. A frame never mixes an old view with a new projection.
+void aurora_set_stereo_view(const AuroraStereoView* view);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // AURORA_STEREO_H
diff --git a/aurora-main/include/aurora/xr_bridge.h b/aurora-main/include/aurora/xr_bridge.h
new file mode 100644
index 0000000..ac62d9b
--- /dev/null
+++ b/aurora-main/include/aurora/xr_bridge.h
@@ -0,0 +1,92 @@
+// Handing the finished frame to an OpenXR session.
+//
+// Aurora knows nothing about OpenXR and the runtime's OpenXR side knows nothing
+// about Dawn; this is the whole of what they say to each other. The runtime owns
+// the shared buffers, because only it knows how big and in which format the XR
+// swapchain is. Aurora owns the drawing, because only it knows what a finished
+// frame is.
+//
+// The shape is deliberately a blit and not a copy. Aurora's presentation image
+// is whatever format the Android surface negotiated -- linear RGBA8 or BGRA8 --
+// while an XR swapchain is commonly sRGB, and AHardwareBuffer has no BGRA format
+// at all, so a texture-to-texture copy is not even expressible for half the
+// combinations. Drawing the frame into the shared texture instead lets the
+// hardware convert channel order and transfer function on the way, and it costs
+// nothing extra: it is the same full-screen blit aurora already does into the
+// swapchain image, pointed somewhere else.
+#ifndef AURORA_XR_BRIDGE_H
+#define AURORA_XR_BRIDGE_H
+
+#ifdef __cplusplus
+#include <cstdint>
+
+extern "C" {
+#else
+#include "stdbool.h"
+#include "stdint.h"
+#endif
+
+// One buffer for aurora to draw the next frame into.
+typedef struct {
+  // AHardwareBuffer*, still owned by the bridge. Aurora imports it, keeps the
+  // import cached against this pointer, and never frees it. The bridge must
+  // therefore keep every buffer it ever hands out alive until
+  // aurora_set_xr_bridge(NULL) has returned, and must not recycle a pointer for
+  // a buffer of a different size or format.
+  void* hardwareBuffer;
+  uint32_t width;
+  uint32_t height;
+} AuroraXrFrameTarget;
+
+typedef struct {
+  // Cheap, called once per frame on aurora's presenter thread. While this is
+  // false aurora presents to the Android surface exactly as it always has, so a
+  // session that has ended or never started costs one predicate.
+  bool (*wants_frames)(void);
+
+  // Hands out the buffer for the frame about to be drawn. False means aurora
+  // should skip this frame entirely rather than fall back to the surface: in an
+  // immersive app the surface is not on screen, and presenting to it would only
+  // burn a blit. The bridge returns false when its ring is full, which is the
+  // normal way it applies back pressure.
+  bool (*acquire_target)(AuroraXrFrameTarget* out);
+
+  // The frame has been drawn and submitted to Dawn's queue. syncFd is a
+  // sync-file descriptor that signals when the drawing has actually finished, or
+  // -1 when Dawn produced no fence; either way ownership passes to the bridge,
+  // which must close it. The bridge waits on it before reading the buffer --
+  // nothing about the two queues is implicitly ordered, they are separate
+  // Vulkan devices.
+  //
+  // vkImageLayout is the VkImageLayout the shared image is in now, as a plain
+  // int32_t so this header stays free of the Vulkan headers. It is reported by
+  // the drawing side rather than agreed in advance because that side does not
+  // choose it either -- Dawn does, and only says so afterwards. The bridge uses
+  // it as the source layout of its own acquire barrier; assuming a layout here
+  // instead is silently wrong on drivers that do not validate it.
+  void (*submit_target)(void* hardwareBuffer, int syncFd, int32_t vkImageLayout);
+
+  // The buffer is being given back unused, because something between acquire and
+  // submit failed. No fence, nothing was written.
+  void (*discard_target)(void* hardwareBuffer);
+} AuroraXrBridge;
+
+// Installs the bridge, or removes it with NULL. The struct is copied, so the
+// caller need not keep it alive; the function pointers must stay valid until
+// this is called again with NULL.
+//
+// Ordering: install it before the OpenXR session starts handing out buffers and
+// remove it before tearing that session down. Removal blocks until aurora is out
+// of every callback, so after it returns the bridge's buffers are unreferenced
+// and can be freed.
+//
+// Thread safety: every callback is invoked from aurora's presenter thread, which
+// is neither the game thread nor the OpenXR thread. The bridge has to guard its
+// own state.
+void aurora_set_xr_bridge(const AuroraXrBridge* bridge);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // AURORA_XR_BRIDGE_H
diff --git a/aurora-main/lib/aurora.cpp b/aurora-main/lib/aurora.cpp
index 11755a3..e7d74f9 100644
--- a/aurora-main/lib/aurora.cpp
+++ b/aurora-main/lib/aurora.cpp
@@ -1,4 +1,5 @@
 #include <aurora/aurora.h>
+#include <aurora/xr_bridge.h>
 
 #ifdef AURORA_ENABLE_GX
 #include "gfx/common.hpp"
@@ -871,9 +872,198 @@ std::shared_ptr<PresentationImage> acquire_presentation_image(size_t slot, uint3
   return image;
 }
 
+// The bridge installed by the OpenXR side while a session is running. The struct is copied here so
+// its caller need not keep one alive, and it is guarded by g_xrBridgeMutex: the presenter holds
+// that mutex across the whole of the XR path, which is what makes set_xr_bridge(nullptr) block
+// until no callback is in flight, as xr_bridge.h promises.
+std::mutex g_xrBridgeMutex;
+AuroraXrBridge g_xrBridge{};
+// Read outside the mutex so a run with no session pays one atomic load per presentation instead of
+// a lock; the mutex is only taken once this says there is something to ask.
+std::atomic<bool> g_xrBridgeInstalled{false};
+
+// Holds the bridge for exactly one presentation. This is the lock set_xr_bridge waits on, so a
+// callback must never install or remove the bridge from inside itself.
+class XrBridgeLease {
+public:
+  XrBridgeLease() noexcept : lock(g_xrBridgeMutex) {}
+
+  // Also covers the bridge having been removed between the unlocked atomic load and this lock.
+  bool wants_frames() const noexcept {
+    return g_xrBridgeInstalled.load(std::memory_order_relaxed) && g_xrBridge.wants_frames();
+  }
+  const AuroraXrBridge* operator->() const noexcept { return &g_xrBridge; }
+
+private:
+  std::lock_guard<std::mutex> lock;
+};
+
+void set_xr_bridge(const AuroraXrBridge* bridge) noexcept {
+  // A half-filled struct would fault on the presenter thread a frame later instead of at the call
+  // site, so refuse it here and keep presenting to the surface.
+  const bool complete = bridge != nullptr && bridge->wants_frames != nullptr &&
+                        bridge->acquire_target != nullptr && bridge->submit_target != nullptr &&
+                        bridge->discard_target != nullptr;
+  if (bridge != nullptr && !complete) {
+    Log.error("Ignoring an XR frame bridge with unset callbacks");
+    return;
+  }
+  // Both Dawn features are needed, and the sync-file one is the dangerous half to be missing. The
+  // AHardwareBuffer import refuses on its own, but without SharedFenceSyncFD the handover still
+  // works and merely stops being ordered against the session's own queue: the frame is composited
+  // while it is still being drawn, which looks like a torn quad with nothing in the log to name the
+  // cause. Refusing here turns that into one line at startup, and the session keeps the plain
+  // coloured quad, which is the honest answer for such a device.
+  if (complete && (!webgpu::g_sharedTextureMemoryAHardwareBufferSupported ||
+                   !webgpu::g_sharedFenceSyncFDSupported)) {
+    Log.error("Refusing the XR frame bridge: the adapter granted AHardwareBuffer import {} and "
+              "sync-file export {}",
+              webgpu::g_sharedTextureMemoryAHardwareBufferSupported,
+              webgpu::g_sharedFenceSyncFDSupported);
+    return;
+  }
+  std::lock_guard lock(g_xrBridgeMutex);
+  // The Dawn imports are cached against the outgoing bridge's buffer pointers, so they have to die
+  // before it does: the bridge is free to destroy those AHardwareBuffers once this returns.
+  webgpu::xr_release_shared_targets();
+  g_xrBridge = complete ? *bridge : AuroraXrBridge{};
+  g_xrBridgeInstalled.store(complete, std::memory_order_release);
+  if (complete) {
+    Log.info("Installed the XR frame bridge");
+  } else {
+    Log.info("Removed the XR frame bridge");
+  }
+}
+
+// An import or a fence that fails does so on every frame, so report it once a second with a count
+// instead of turning a broken session into a 72 Hz log flood.
+void warn_xr_bridge_failure(const char* stage) noexcept {
+  static size_t droppedSinceWarning = 0;
+  static PresentClock::time_point lastWarning{};
+  ++droppedSinceWarning;
+  const auto now = PresentClock::now();
+  if (lastWarning != PresentClock::time_point{} && now - lastWarning < std::chrono::seconds(1)) {
+    return;
+  }
+  Log.warn("XR frame bridge dropped {} frame(s); last failure was {}", droppedSinceWarning, stage);
+  droppedSinceWarning = 0;
+  lastWarning = now;
+}
+
+// Draws the finished frame into one of the bridge's AHardwareBuffers instead of into the Android
+// surface. A false return is a skipped frame and never a fallback to the surface: while a session
+// runs the surface is not on screen, so presenting to it as well would only burn a blit.
+bool present_job_to_xr_bridge(const PresentationJob& job, const XrBridgeLease& bridge,
+                              PresentClock::time_point submissionStarted) {
+  ZoneScopedN("XR presentation job");
+  std::chrono::nanoseconds lateBy{};
