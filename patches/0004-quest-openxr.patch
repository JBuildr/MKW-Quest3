diff --git a/runtime/src/vr/screen.frag b/runtime/src/vr/screen.frag
new file mode 100644
index 0000000..aeff47f
--- /dev/null
+++ b/runtime/src/vr/screen.frag
@@ -0,0 +1,26 @@
+#version 450
+
+layout(set = 0, binding = 0) uniform sampler2D gameImage;
+
+layout(push_constant) uniform Push {
+    mat4 mvp;
+    vec4 options;
+} push;
+
+layout(location = 0) in vec2 inTexCoord;
+layout(location = 0) out vec4 outColour;
+
+void main() {
+    vec3 rgb = texture(gameImage, inTexCoord).rgb;
+    // options.x is 1.0 when the eye swapchain is an sRGB format. The shared
+    // image is UNORM, so sampling returns aurora's bytes unchanged, and an sRGB
+    // attachment would then encode them a second time and wash the picture out.
+    // Decoding here cancels that encode exactly, which leaves the same bytes in
+    // the swapchain image that Cinema's vkCmdCopyImage puts there.
+    if (push.options.x > 0.5) {
+        vec3 low = rgb / 12.92;
+        vec3 high = pow((rgb + 0.055) / 1.055, vec3(2.4));
+        rgb = mix(low, high, step(vec3(0.04045), rgb));
+    }
+    outColour = vec4(rgb, 1.0);
+}
diff --git a/runtime/src/vr/screen.vert b/runtime/src/vr/screen.vert
new file mode 100644
index 0000000..c1ea578
--- /dev/null
+++ b/runtime/src/vr/screen.vert
@@ -0,0 +1,24 @@
+#version 450
+
+// The screen is four corners of a triangle strip and nothing else, so there is
+// no vertex buffer and no index buffer to keep alive: gl_VertexIndex is the
+// whole of the geometry. mvp already carries the rectangle's size, its distance
+// and its height offset, so the corner below is a plain unit square.
+layout(push_constant) uniform Push {
+    mat4 mvp;
+    vec4 options;
+} push;
+
+layout(location = 0) out vec2 outTexCoord;
+
+void main() {
+    // 0 -> (-1,-1), 1 -> (+1,-1), 2 -> (-1,+1), 3 -> (+1,+1): the strip order a
+    // four-vertex vkCmdDraw produces.
+    vec2 corner = vec2((gl_VertexIndex & 1) == 0 ? -1.0 : 1.0,
+                       (gl_VertexIndex & 2) == 0 ? -1.0 : 1.0);
+    // Row 0 of the shared image is the top of the picture and v grows downward,
+    // so the corner that is up in the room has to sample v = 0. Getting this
+    // backwards shows the game upside down rather than failing.
+    outTexCoord = vec2(corner.x * 0.5 + 0.5, 0.5 - corner.y * 0.5);
+    gl_Position = push.mvp * vec4(corner, 0.0, 1.0);
+}
diff --git a/runtime/src/vr/vr_game_state.cpp b/runtime/src/vr/vr_game_state.cpp
