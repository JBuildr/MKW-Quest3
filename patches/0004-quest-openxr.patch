+
+void PollVrSettingsRequest() noexcept {
+    // One flag, read on the retrace side. The header says why the OpenXR thread
+    // may not do any of this itself. Nothing below touches ImGui or SDL -- it
+    // only moves two bools -- so it is safe to run before this frame's ImGui
+    // context has been started.
+    if (!Vr::ConsumeSettingsRequest()) {
+        return;
+    }
+    const bool opening = !g_vrPanelVisible;
+    g_vrPanelVisible = opening;
+    // The top bar comes along, so that the rest of the overlay is on screen too,
+    // exactly as F10 shows it on a desktop.
+    SetTopBarVisible(opening);
+    if (opening) {
+        g_vrPanelFocusPending = true;
+    } else {
+        // A slider still active when the panel closed never reaches its deferred
+        // write, so flush here rather than lose the adjustment.
+        WriteBackVrSettings();
+    }
+}
+
