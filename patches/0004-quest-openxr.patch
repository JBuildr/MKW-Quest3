+// OpenXR session for the Quest build: one host thread, one composition layer.
+//
+// Build 1 answered whether a solid-coloured screen with head tracking appears in
+// the headset. Build 2 answers the next single question -- does the real game
+// image appear on that quad -- and nothing else: the game still presents to the
+// SDL surface as well, and there is still exactly one quad layer.
+//
+// The image has to cross two Vulkan devices, because OpenXR hands out swapchain
+// images only on the device it created itself and Dawn will not adopt a foreign
+// one. So this file allocates a small ring of AHardwareBuffers sized to the XR
+// swapchain, hands them to aurora through <aurora/xr_bridge.h>, and every frame
+// takes the most recently finished one, waits on the sync-file descriptor that
+// says its drawing is done, and transfers it into the acquired swapchain image.
+// Aurora fills the buffer with a blit rather than a copy because its presentation
+// image is linear RGBA8 or BGRA8 while an XR swapchain is sRGB and
+// AHardwareBuffer has no BGRA format at all; the bridge header has the argument.
+//
+// Build A adds the second way to present. Cinema is untouched: one quad layer,
+// one swapchain, one transfer. Stereo instead locates the two eye views every
+// frame and draws the very same flat game image into a per-eye swapchain with a
+// small graphics pipeline, then submits XrCompositionLayerProjection. The game
+// still renders exactly once and exactly as before -- what changes is only how
+// the finished picture reaches the compositor, which is what has to be proven
+// before the renderer is asked to draw twice. The choice is made per frame,
+// because menus are going to stay flat while a race goes per-eye.
+//
+// Everything below runs on the thread Start() creates -- except the four bridge
+// callbacks, which aurora calls on its presenter thread and which therefore
+// touch nothing but the ring behind its own mutex. The session thread never pumps
+// SDL events, never calls into aurora and never touches the settings overlay:
+// those belong to the retrace context, and JNI from a guest fiber aborts under
+// ART (the Fix AB rule). A plain thread is fine for JNI as long as it attaches
+// itself to the VM, which it does below.
+#include "vr/vr_session.h"
+
+#include "runtime_log.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <future>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+// runtime_log.h owns the canonical tag list and this module must not edit that
+// header, so the tag lives here behind a guard: the day it moves into the list
+// this file keeps compiling with exactly one definition.
+#ifndef RT_TAG_VR
+#define RT_TAG_VR "vr"
+#endif
+
+// The OpenXR loader is fetched and built for the Android target only, while the
+// runtime's CMake globs src/*.cpp for every platform -- so the desktop builds
+// compile this file too and have to get the refusing stub below.
+#if defined(__ANDROID__) && __has_include(<openxr/openxr.h>)
+#define MKW_VR_OPENXR 1
+#else
+#define MKW_VR_OPENXR 0
+#endif
+
+#if MKW_VR_OPENXR
+#include <cerrno>
+#include <dlfcn.h>
+#include <jni.h>
+#include <poll.h>
+#include <unistd.h>
+
+#include <android/hardware_buffer.h>
+
+#include <SDL3/SDL_system.h>
+
+// The whole of what this module and aurora say to each other. Nothing else in
+// the runtime includes it: the bridge is installed from here and from nowhere
+// else, so the game side keeps its single presentation path.
+#include <aurora/xr_bridge.h>
+
+// The other half of what this module and aurora say to each other: the pair of
+// matrices that renders the game through the headset instead of onto a screen in
+// the room. The header is the contract -- read it before touching anything below
+// that builds either matrix.
+#include <aurora/stereo.h>
+
+#include "vr_game_state.h"
+
+// Every Vulkan entry point here is fetched through vkGetInstanceProcAddr, so the
+// prototypes would only invite an accidental link-time dependency on libvulkan.
+// VK_USE_PLATFORM_ANDROID_KHR is what declares vulkan_android.h at all: without
+// it VkImportAndroidHardwareBufferInfoANDROID and the format-properties structs
+// the shared image is imported through do not exist.
+#define VK_NO_PROTOTYPES
+#define VK_USE_PLATFORM_ANDROID_KHR
+#include <vulkan/vulkan.h>
+
+// openxr_platform.h keeps the Android half and the Vulkan half of the API behind
+// these two macros; without them XrLoaderInitInfoAndroidKHR and the
+// vulkan_enable2 entry points are not even declared. XR_EXTENSION_PROTOTYPES is
+// deliberately left undefined: extension functions have to come from
+// xrGetInstanceProcAddr, and leaving their prototypes out turns a mistake there
+// into a compile error instead of a link error.
+#define XR_USE_PLATFORM_ANDROID
+#define XR_USE_GRAPHICS_API_VULKAN
+#include <openxr/openxr.h>
+#include <openxr/openxr_platform.h>
+
+// The two shader modules the Stereo path draws its screen with. It is a
+// generated header -- the SPIR-V in it came out of the NDK's own glslc and the
+// GLSL it was built from sits above each array, next to the command that
+// rebuilds it. Nothing in this file may write SPIR-V by hand.
+#include "vr_screen_spirv.h"
+#endif
+
+namespace Vr {
+
+Mode ModeFromString(const char* text) noexcept {
+    if (text == nullptr) {
+        return Mode::Panel;
+    }
+    if (std::strcmp(text, "cinema") == 0) {
+        return Mode::Cinema;
+    }
+    if (std::strcmp(text, "stereo") == 0) {
+        return Mode::Stereo;
+    }
+    return Mode::Panel;
+}
+
+const char* ModeToString(Mode mode) noexcept {
+    switch (mode) {
+    case Mode::Cinema:
+        return "cinema";
+    case Mode::Stereo:
+        return "stereo";
+    case Mode::Panel:
+        break;
+    }
+    return "panel";
+}
+
+Performance PerformanceFromString(const char* text) noexcept {
+    if (text == nullptr) {
+        return Performance::SustainedHigh;
+    }
+    if (std::strcmp(text, "default") == 0) {
+        return Performance::Default;
+    }
+    if (std::strcmp(text, "sustained_low") == 0) {
+        return Performance::SustainedLow;
+    }
+    if (std::strcmp(text, "boost") == 0) {
+        return Performance::Boost;
+    }
+    return Performance::SustainedHigh;
+}
+
+const char* PerformanceToString(Performance level) noexcept {
+    switch (level) {
+    case Performance::Default:
+        return "default";
+    case Performance::SustainedLow:
+        return "sustained_low";
+    case Performance::Boost:
+        return "boost";
+    case Performance::SustainedHigh:
+        break;
+    }
+    return "sustained_high";
+}
+
+#if !MKW_VR_OPENXR
+
+// Everywhere but Android: the header exists for the configuration parser and the
+// settings overlay, and there is no session to start.
+bool Start(const Settings& settings) noexcept {
+    if (settings.mode != Mode::Panel) {
+        RT_LOGF(RT_TAG_VR, "start: this build has no OpenXR support compiled in; staying a flat panel\n");
+    }
+    return false;
+}
+
+void Stop() noexcept {}
+bool Active() noexcept { return false; }
+Mode CurrentMode() noexcept { return Mode::Panel; }
+bool SetMode(Mode) noexcept { return false; }
+bool ConsumeSettingsRequest() noexcept { return false; }
+void SetSeatFraction(float) noexcept {}
+void SetHideDriver(bool) noexcept {}
+void SetEgoCamera(bool) noexcept {}
+void SetSeatPlacement(float, float) noexcept {}
+void SetSeat(float, float) noexcept {}
+void SetHud(float, float) noexcept {}
+void SetWorldScale(float) noexcept {}
+void SetHeadTranslation(float) noexcept {}
+void SetScreenPlacement(float, float) noexcept {}
+ControllerState CurrentControllers() noexcept { return ControllerState{}; }
+void RecentreStereo() noexcept {}
+void SampleGuestFrame() noexcept {}
+Stats CurrentStats() noexcept { return Stats{}; }
+
+#else
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+// MKW_VR_DEBUG is this module's own switch, in the spirit of AURORA_GX_DEBUG: a
+// decimal bitmask, read once. Bit 0 turns on the per-second timing line and the
+// occasional note about the session's input state; everything that names a
+// failure is printed unconditionally. main.cpp exports the variable from
+// [debug] vr_debug in Config.toml.
+constexpr uint32_t kDebugFrameTiming = 1u;
+// Bit 1 transfers the shared image with vkCmdBlitImage instead of
+// vkCmdCopyImage. The two differ in exactly one way, and it is the one thing
+// about build 2 that only the headset can settle: a copy moves the bytes aurora
+// wrote unchanged, which is what the flat panel shows today, while a blit reads
+// them through the shared image's UNORM view and writes them through the
+// swapchain's sRGB view, encoding on the way. If the image appears but is washed
+// out or too dark, this bit says which of the two the compositor wanted.
+constexpr uint32_t kDebugTransferBlit = 2u;
+// Bit 2 prints the driver's head once a second and changes nothing else. It is
+// a measurement, not a feature: the seat as a fraction of the way to the kart
+// missed the driver's place because the fraction ends at the kart's ORIGIN,
+// which is at the bottom of the machine, and the game names the driver's bones
+// itself. Before the eye is moved onto one of them, two things have to be seen
+// rather than assumed -- that the chain resolves at all in a running race, and
+// whether the matrix behind it is world space or a parent's. Both are in the
+// line this bit prints. Its own bit, because the timing line on bit 0 is what
+// the frame-rate work reads and neither should have to be filtered out of the
+// other.
+constexpr uint32_t kDebugHeadProbe = 4u;
+
+uint32_t DebugFlags() {
+    static const uint32_t flags = []() -> uint32_t {
+        const char* value = std::getenv("MKW_VR_DEBUG");
+        return value != nullptr ? static_cast<uint32_t>(std::strtoul(value, nullptr, 10)) : 0u;
+    }();
+    return flags;
+}
+
+double Milliseconds(Clock::duration span) {
+    return std::chrono::duration<double, std::milli>(span).count();
+}
+
+// A result's name says far more in logcat than its number, but xrResultToString
+// needs a live instance, so anything that fails before xrCreateInstance only
+// gets the code.
+std::string ResultText(XrInstance instance, XrResult result) {
+    char name[XR_MAX_RESULT_STRING_SIZE] = {};
+    if (instance != XR_NULL_HANDLE && xrResultToString(instance, result, name) == XR_SUCCESS) {
+        return name;
+    }
+    return std::to_string(static_cast<int>(result));
+}
+
+const char* PerfSubDomainText(XrPerfSettingsSubDomainEXT subDomain) {
+    switch (subDomain) {
+    case XR_PERF_SETTINGS_SUB_DOMAIN_COMPOSITING_EXT:
+        return "compositing";
+    case XR_PERF_SETTINGS_SUB_DOMAIN_RENDERING_EXT:
+        return "rendering";
+    case XR_PERF_SETTINGS_SUB_DOMAIN_THERMAL_EXT:
+        return "thermal";
+    default:
+        break;
+    }
+    return "unknown";
+}
+
+XrPerfSettingsLevelEXT PerfLevel(Performance performance) {
+    switch (performance) {
+    case Performance::SustainedLow:
+        return XR_PERF_SETTINGS_LEVEL_SUSTAINED_LOW_EXT;
+    case Performance::Boost:
+        return XR_PERF_SETTINGS_LEVEL_BOOST_EXT;
+    case Performance::SustainedHigh:
+    case Performance::Default:
+        break;
+    }
+    return XR_PERF_SETTINGS_LEVEL_SUSTAINED_HIGH_EXT;
+}
+
+// Solid amber: no grey living room and no black failure produces this by
+// accident. Build 2 still shows it, but only until aurora's first frame arrives
+// -- so amber in the headset now means "the session runs and the bridge
+// delivered nothing", which is a far more useful failure than black.
+constexpr float kQuadColour[4] = {0.95f, 0.45f, 0.10f, 1.0f};
+
+// Three, to match the three images the runtime gave the swapchain in build 1.
+// One of them is always the frame on screen, which leaves two for aurora to work
+// ahead in; a fourth would only add latency, because a frame that arrives while
+// a newer one is already waiting is dropped rather than shown late.
+constexpr size_t kSharedFrameCount = 3;
+
+// Only reached on the CPU fallback path below. Long enough that a slow frame is
+// waited out, short enough that a fence which will never signal costs a stutter
+// instead of a hung session thread and a compositor timeout.
+constexpr int kFenceTimeoutMs = 500;
+
+// State the rest of the runtime reads. Active() is asked from the guest thread
+// while the session thread writes it, hence the atomics; the statistics are a
+// plain struct behind their own mutex because they change once a second.
+std::atomic_bool g_active{false};
+// Forces the per-eye path everywhere, menus included. Off by default and
+// only for comparing one against the other: the menus are drawn for a
+// television and a camera inside one is not a pleasant place to be.
+std::atomic_bool g_stereoInMenus{false};
+std::atomic_bool g_stopRequested{false};
+std::atomic<Mode> g_mode{Mode::Panel};
+// Raised by the session thread when the menu button has been held past
+// kMenuLongPressMs, and consumed by the retrace/guest context. Nothing but this
+// flag crosses from the OpenXR thread towards the overlay: ImGui, SDL and
+// everything else aurora owns are refused outside the scheduler context, and a
+// JNI call from a guest fiber aborts under ART (the Fix AB rule).
+std::atomic_bool g_settingsRequested{false};
+
+// The dials the settings overlay is allowed to turn while the session runs.
+//
+// The session thread owns its own Settings and reads it every frame; the overlay
+// runs in the retrace context and must never write into that copy. So each live
+// dial is one atomic here, written by whoever turns it and folded into the
+// session's Settings once per frame by RefreshLiveSettings(). A plain float
+// written from another thread would be a data race that shows up as one torn
+// frame in a headset, which is exactly the kind of fault nobody can reproduce.
+//
+// Everything not in this list is read once by Start(): the swapchain's aspect is
+// built from screen_width and screen_height, and the reference space from
+// head_tracking, so those cannot move without recreating what was made from
+// them. The overlay labels them "next launch" rather than offering a control
+// that quietly does nothing.
+std::atomic<float> g_liveCameraSeat{0.0f};
+// Read by the guest thread once per drawn frame, written by whoever turns the
+// dial. Relaxed is enough: a frame either side of the switch is a frame either
+// side of the switch.
+std::atomic<bool> g_liveHideDriver{false};
+std::atomic<bool> g_liveEgoCamera{false};
+std::atomic<float> g_liveSeatHeight{VrGameState::kMeasuredHeadHeight};
+std::atomic<float> g_liveSeatForward{VrGameState::kMeasuredHeadForward};
+// The dials' own limits, and the config parser's. They are the same two numbers
+// on purpose: a range narrower than what the file can hold means the first touch
+// of a slider silently clamps whatever was in the file and writes the clamp back,
+// with no way to the old value -- which is exactly what happened once already to
+// a seat set to 4 m against a slider that stopped at 2.
+constexpr float kSeatHeightMin = 0.0f;
+constexpr float kSeatHeightMax = 200.0f;
+constexpr float kSeatForwardMin = -100.0f;
+constexpr float kSeatForwardMax = 100.0f;
+// Guest thread only: whether the bits are currently ours to put back. A plain
+// bool because only the guest thread ever touches it.
+bool g_driverWasHidden = false;
+// How many scene objects actually had to be changed since the last log line.
+// Zero on every frame but the first after a model rebuild, so anything else says
+// the game is rebuilding the driver -- or fighting over the same two bits.
+std::atomic<uint32_t> g_hiddenDriverChanges{0};
+std::atomic<float> g_liveCameraForward{0.0f};
+std::atomic<float> g_liveCameraUp{0.0f};
+std::atomic<float> g_liveHudScale{0.55f};
+std::atomic<float> g_liveHudOffsetY{0.0f};
+std::atomic<float> g_liveWorldScale{100.0f};
+std::atomic<float> g_liveHeadTranslation{0.0f};
+std::atomic<float> g_liveScreenDistance{2.5f};
+std::atomic<float> g_liveScreenHeightOffset{0.0f};
+// Armed, not applied: RecentreStereo() can be called from any thread, and the
+// reference orientation may only be captured from a head pose the session thread
+// has just located. It starts armed so the first stereo frame of a run captures
+// one without anybody having to ask.
+std::atomic_bool g_recentreRequested{true};
+std::mutex g_statsMutex;
+Stats g_stats;
+// The controller snapshot the guest's PAD path reads, published once per frame.
+// Same shape as the statistics above and for the same reason: it is a small
+// plain struct, both sides do nothing under the lock but copy it, and no OpenXR
+// call is ever made while it is held. So the frame loop can never be held up by
+// the game thread waiting on a pad, and the game thread can never be held up by
+// an xrWaitFrame -- which is the failure that would show as the race stuttering
+// in step with the compositor.
+std::mutex g_controllersMutex;
+ControllerState g_controllers;
+
+void PublishControllers(const ControllerState& state) {
