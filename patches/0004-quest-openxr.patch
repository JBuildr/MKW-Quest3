+//
+// Same shape as the graphics and audio sections above: one cached value per
+// setting, applied live where the session can take it, written back through the
+// RuntimeConfigFile setters. What is different is that the OpenXR session copies
+// Vr::Settings ONCE at Start and then owns that copy on its own thread, so only
+// the dials with a Vr::Set* live setter behind them can move while the app runs.
+// Everything else says "next launch" in as many words -- a control that silently
+// does nothing is worse than no control at all, because the player then spends
+// the evening believing the setting is broken rather than deferred.
+// ---------------------------------------------------------------------------
+
+// Shown by a long press of the controller's menu button. Separate from the top
+// bar because the top bar is a main menu bar, and ImGui's navigation reaches a
+// menu bar only through its menu layer -- which on a keyboard is Alt and on this
+// device is nothing at all. A plain window can simply be given nav focus.
+bool g_vrPanelVisible = false;
+bool g_vrPanelFocusPending = false;
+bool g_vrSettingsDirty = false;
+
+bool g_vrHideDriver = RuntimeConfigFile::VrHideDriver();
+bool g_vrWrittenHideDriver = g_vrHideDriver;
+bool g_vrEgoCamera = RuntimeConfigFile::VrEgoCamera();
+bool g_vrWrittenEgoCamera = g_vrEgoCamera;
+float g_vrSeatHeight = RuntimeConfigFile::VrSeatHeight();
+float g_vrSeatForward = RuntimeConfigFile::VrSeatForward();
+float g_vrWrittenSeatHeight = g_vrSeatHeight;
+float g_vrWrittenSeatForward = g_vrSeatForward;
+float g_vrCameraSeat = RuntimeConfigFile::VrCameraSeat();
+float g_vrCameraForward = RuntimeConfigFile::VrCameraForward();
+float g_vrCameraUp = RuntimeConfigFile::VrCameraUp();
+float g_vrHudScale = RuntimeConfigFile::VrHudScale();
+float g_vrHudOffsetY = RuntimeConfigFile::VrHudOffsetY();
+float g_vrWorldScale = RuntimeConfigFile::VrWorldScale();
+float g_vrHeadTranslation = RuntimeConfigFile::VrHeadTranslation();
+float g_vrScreenDistance = RuntimeConfigFile::VrScreenDistance();
+float g_vrScreenHeightOffset = RuntimeConfigFile::VrScreenHeightOffset();
+float g_vrScreenWidth = RuntimeConfigFile::VrScreenWidth();
+float g_vrScreenHeight = RuntimeConfigFile::VrScreenHeight();
+
+// Seeded from the same accessors, so opening the panel and closing it again
+// without touching anything writes nothing at all.
+float g_vrWrittenCameraSeat = g_vrCameraSeat;
+float g_vrWrittenCameraForward = g_vrCameraForward;
+float g_vrWrittenCameraUp = g_vrCameraUp;
+float g_vrWrittenHudScale = g_vrHudScale;
+float g_vrWrittenHudOffsetY = g_vrHudOffsetY;
+float g_vrWrittenWorldScale = g_vrWorldScale;
+float g_vrWrittenHeadTranslation = g_vrHeadTranslation;
+float g_vrWrittenScreenDistance = g_vrScreenDistance;
+float g_vrWrittenScreenHeightOffset = g_vrScreenHeightOffset;
+float g_vrWrittenScreenWidth = g_vrScreenWidth;
+float g_vrWrittenScreenHeight = g_vrScreenHeight;
+
+// Config.toml is rewritten in full by every WriteSetting, so the file is not
+// touched while a slider is being dragged -- a thumbstick held over for a second
+// would otherwise rewrite it seventy times over. The live setters have already
+// applied the value by then; this only decides when it survives a relaunch.
+void WriteBackVrSettings() {
+    if (!g_vrSettingsDirty) {
+        return;
+    }
+    g_vrSettingsDirty = false;
+    // Only what actually moved. Each setter rewrites the WHOLE of Config.toml --
+    // read every line, replace one, write every line back -- so calling all seven
+    // for a single nudge of one slider meant seven full rewrites, synchronously,
+    // on the thread that is drawing the frame. The values are compared against
+    // what was last written rather than tracked with a flag per control, because
+    // a comparison cannot be forgotten when a new control is added below.
+    if (g_vrHideDriver != g_vrWrittenHideDriver) {
+        RuntimeConfigFile::SetVrHideDriver(g_vrHideDriver);
+        g_vrWrittenHideDriver = g_vrHideDriver;
+    }
+    if (g_vrEgoCamera != g_vrWrittenEgoCamera) {
+        RuntimeConfigFile::SetVrEgoCamera(g_vrEgoCamera);
+        g_vrWrittenEgoCamera = g_vrEgoCamera;
+    }
+    if (g_vrSeatHeight != g_vrWrittenSeatHeight || g_vrSeatForward != g_vrWrittenSeatForward) {
+        RuntimeConfigFile::SetVrSeatPlacement(g_vrSeatHeight, g_vrSeatForward);
+        g_vrWrittenSeatHeight = g_vrSeatHeight;
+        g_vrWrittenSeatForward = g_vrSeatForward;
+    }
+    if (g_vrCameraSeat != g_vrWrittenCameraSeat) {
+        RuntimeConfigFile::SetVrCameraSeat(g_vrCameraSeat);
+        g_vrWrittenCameraSeat = g_vrCameraSeat;
+    }
+    if (g_vrCameraForward != g_vrWrittenCameraForward || g_vrCameraUp != g_vrWrittenCameraUp) {
+        RuntimeConfigFile::SetVrSeat(g_vrCameraForward, g_vrCameraUp);
+        g_vrWrittenCameraForward = g_vrCameraForward;
+        g_vrWrittenCameraUp = g_vrCameraUp;
+    }
+    if (g_vrHudScale != g_vrWrittenHudScale || g_vrHudOffsetY != g_vrWrittenHudOffsetY) {
+        RuntimeConfigFile::SetVrHud(g_vrHudScale, g_vrHudOffsetY);
+        g_vrWrittenHudScale = g_vrHudScale;
+        g_vrWrittenHudOffsetY = g_vrHudOffsetY;
+    }
+    if (g_vrWorldScale != g_vrWrittenWorldScale) {
+        RuntimeConfigFile::SetVrWorldScale(g_vrWorldScale);
+        g_vrWrittenWorldScale = g_vrWorldScale;
+    }
+    if (g_vrHeadTranslation != g_vrWrittenHeadTranslation) {
+        RuntimeConfigFile::SetVrHeadTranslation(g_vrHeadTranslation);
+        g_vrWrittenHeadTranslation = g_vrHeadTranslation;
+    }
+    if (g_vrScreenDistance != g_vrWrittenScreenDistance) {
+        RuntimeConfigFile::SetVrScreenDistance(g_vrScreenDistance);
+        g_vrWrittenScreenDistance = g_vrScreenDistance;
+    }
+    if (g_vrScreenHeightOffset != g_vrWrittenScreenHeightOffset) {
+        RuntimeConfigFile::SetVrScreenHeightOffset(g_vrScreenHeightOffset);
+        g_vrWrittenScreenHeightOffset = g_vrScreenHeightOffset;
+    }
+    if (g_vrScreenWidth != g_vrWrittenScreenWidth || g_vrScreenHeight != g_vrWrittenScreenHeight) {
+        RuntimeConfigFile::SetVrScreenSize(g_vrScreenWidth, g_vrScreenHeight);
+        g_vrWrittenScreenWidth = g_vrScreenWidth;
+        g_vrWrittenScreenHeight = g_vrScreenHeight;
+    }
+}
+
+void DrawVrSettings() {
+    const bool sessionRunning = Vr::Active();
+    if (!sessionRunning) {
+        ImGui::TextDisabled("No headset session is running. Changes are saved and used at the next launch.");
+        ImGui::Separator();
+    }
+
+    // Mode. Panel is deliberately absent: Horizon OS decides panel or immersive
+    // when the app launches and Vr::SetMode refuses it, so offering it here would
+    // be offering a control that can only log a refusal.
+    int mode = Vr::CurrentMode() == Vr::Mode::Stereo ? 1 : 0;
+    static constexpr const char* kVrModes[] = {
+        "Cinema - one flat screen in the room",
+        "Stereo - through the headset, per eye",
+    };
+    ImGui::SetNextItemWidth(300.0f);
+    if (ImGui::Combo("Mode", &mode, kVrModes, static_cast<int>(std::size(kVrModes)))) {
+        const Vr::Mode wanted = mode == 1 ? Vr::Mode::Stereo : Vr::Mode::Cinema;
+        // Live: SetMode only stores an atomic that the frame loop reads on its
+        // next turn, so the switch costs no session and no relaunch.
+        if (Vr::SetMode(wanted) || !sessionRunning) {
+            RuntimeConfigFile::SetVrMode(Vr::ModeToString(wanted));
+        }
+    }
+    ImGui::TextDisabled("Stereo still shows the flat screen outside a race.");
+
+    ImGui::Separator();
+    ImGui::TextUnformatted("Seat (Stereo)");
+    bool seatChanged = false;
+    ImGui::SetNextItemWidth(220.0f);
+    // The choice first, because the two dials under it only mean anything on one
+    // side of it. Off is not a degraded mode: the game's own chase camera, seen
+    // in stereo with the head free to look around, is a way of playing this.
+    if (ImGui::Checkbox("First-person seat", &g_vrEgoCamera)) {
+        seatChanged = true;
+        Vr::SetEgoCamera(g_vrEgoCamera);
+    }
+    ImGui::TextDisabled("Off = the game's own chase camera, in stereo.");
+
+    // Game units along the kart's own axes, and the defaults are MEASURED: the
+    // driver's head bone sits 54 above the kart's origin and 2 behind it. So
+    // these dials start correct and trim from there -- which is the whole
+    // difference to the seat that came before them, where the dial had to find
+    // the answer and two dials pulled in different directions while it tried.
+    //
+    // The ranges deliberately cover everything the config parser accepts. A
+    // range narrower than the file's value means the first touch clamps it and
+    // writes the clamp back, with no way to the old number.
+    ImGui::BeginDisabled(!g_vrEgoCamera);
+    bool seatPlacementChanged = false;
+    seatPlacementChanged |= ImGui::SliderFloat("Seat height", &g_vrSeatHeight, 0.0f, 200.0f, "%.1f");
+    seatPlacementChanged |= ImGui::SliderFloat("Seat forward", &g_vrSeatForward, -100.0f, 100.0f, "%.1f");
+    if (seatPlacementChanged) {
+        seatChanged = true;
+        Vr::SetSeatPlacement(g_vrSeatHeight, g_vrSeatForward);
+    }
+    ImGui::TextDisabled("Measured from the driver's head bone: 54.0 up, -2.0 forward.");
+    ImGui::EndDisabled();
+
+    // Next to the seat because it belongs to it: from the driver's place his own
+    // head is in front of the eye. The kart stays visible either way -- that is
+    // the point of it, and there is deliberately no control here to hide it.
+    if (ImGui::Checkbox("Hide driver", &g_vrHideDriver)) {
+        seatChanged = true;
+        Vr::SetHideDriver(g_vrHideDriver);
+    }
+    ImGui::TextDisabled("Takes the driver out of the picture. The kart stays.");
+
+    // The range has to cover every value the parser accepts, or the first touch
+    // of the slider silently clamps whatever was in the file and there is no way
+    // back to it -- which is exactly what happened to a seat set to 4 m against a
+    // slider that stopped at 2. ImGui clamps on interaction, not on display, so
+    // the setting is destroyed by looking at it.
+    seatChanged |= ImGui::SliderFloat("Forward", &g_vrCameraForward, -2.0f, 10.0f, "%.2f m");
+    ImGui::SetNextItemWidth(220.0f);
+    seatChanged |= ImGui::SliderFloat("Up", &g_vrCameraUp, -2.0f, 4.0f, "%.2f m");
+    if (seatChanged) {
+        // Live: the session folds this into its own copy at the top of its next
+        // frame, so the eye moves while the slider is still being held.
+        Vr::SetSeat(g_vrCameraForward, g_vrCameraUp);
+        g_vrSettingsDirty = true;
+    }
+
+    ImGui::Separator();
+    ImGui::TextUnformatted("HUD (Stereo)");
+    bool hudChanged = false;
+    ImGui::SetNextItemWidth(220.0f);
+    hudChanged |= ImGui::SliderFloat("Scale", &g_vrHudScale, 0.1f, 1.0f, "%.2f");
+    ImGui::SetNextItemWidth(220.0f);
+    hudChanged |= ImGui::SliderFloat("Vertical offset", &g_vrHudOffsetY, -1.0f, 1.0f, "%.2f");
+    if (hudChanged) {
+        Vr::SetHud(g_vrHudScale, g_vrHudOffsetY);
+        g_vrSettingsDirty = true;
+    }
+
+    ImGui::Separator();
+    ImGui::TextUnformatted("World (Stereo)");
+    ImGui::SetNextItemWidth(220.0f);
+    if (ImGui::SliderFloat("World scale", &g_vrWorldScale, 10.0f, 400.0f, "%.0f units/m")) {
+        Vr::SetWorldScale(g_vrWorldScale);
+        g_vrSettingsDirty = true;
+    }
+    if (ImGui::IsItemHovered()) {
+        ImGui::SetTooltip("Game units per metre. It also scales the seat above, so the two move together.");
+    }
+    ImGui::SetNextItemWidth(220.0f);
+    if (ImGui::SliderFloat("Head movement", &g_vrHeadTranslation, 0.0f, 1.0f, "%.2f")) {
+        Vr::SetHeadTranslation(g_vrHeadTranslation);
+        g_vrSettingsDirty = true;
+    }
+    if (ImGui::Button("Recentre now")) {
+        // Arms a flag the session thread spends on its next stereo frame; it
+        // touches no OpenXR state here, which is why it is safe from this side.
+        Vr::RecentreStereo();
+    }
+
+    ImGui::Separator();
+    ImGui::TextUnformatted("Screen (Cinema)");
+    bool placementChanged = false;
+    ImGui::SetNextItemWidth(220.0f);
+    placementChanged |= ImGui::SliderFloat("Distance", &g_vrScreenDistance, 0.5f, 8.0f, "%.2f m");
+    ImGui::SetNextItemWidth(220.0f);
+    placementChanged |= ImGui::SliderFloat("Height", &g_vrScreenHeightOffset, -2.0f, 2.0f, "%.2f m");
+    if (placementChanged) {
+        // Live: the quad's pose is rebuilt from these every frame.
+        Vr::SetScreenPlacement(g_vrScreenDistance, g_vrScreenHeightOffset);
+        g_vrSettingsDirty = true;
+    }
+    ImGui::SetNextItemWidth(220.0f);
+    bool sizeChanged = ImGui::SliderFloat("Width", &g_vrScreenWidth, 1.0f, 8.0f, "%.2f m");
+    ImGui::SetNextItemWidth(220.0f);
+    sizeChanged |= ImGui::SliderFloat("Height (size)", &g_vrScreenHeight, 0.5f, 5.0f, "%.2f m");
+    if (sizeChanged) {
+        g_vrSettingsDirty = true;
+    }
+    // Said out loud rather than left to be discovered: the swapchain is created
+    // once, at startup, with an aspect taken from these two, so moving them now
+    // would stretch the picture instead of resizing the screen.
+    ImGui::TextDisabled("Screen size is applied at the next launch.");
+
+    // The write-back point. Deferred until nothing is being dragged, so that one
+    // adjustment costs one rewrite of Config.toml instead of one per frame.
+    if (g_vrSettingsDirty && !ImGui::IsAnyItemActive()) {
+        WriteBackVrSettings();
+    }
+}
+
+// Controller navigation for the overlay.
+//
+// Nothing here re-implements navigation: ImGui already has it and aurora turns it
+// on (ImGuiConfigFlags_NavEnableGamepad, lib/imgui.cpp). What it has no SOURCE
+// for on this device is the controllers -- they arrive through OpenXR and are not
+// SDL gamepads, and imgui_impl_sdl3 clears ImGuiBackendFlags_HasGamepad in every
+// NewFrame when it finds no SDL gamepad open. That clear lands after anything the
+// retrace side could do about it and before NavUpdate reads the flag, so the
+// ImGuiKey_Gamepad* half of nav cannot be woken from here at all.
+//
+// The KEYBOARD half is gated on ImGuiConfigFlags_NavEnableKeyboard instead, and a
+// config flag belongs to the app, not the backend -- nothing clears it. So that
+// is the half this feeds: the sticks become the arrow keys, the right hand's
+// buttons become Space (activate, and tweak a focused slider), the left hand's
+// becomes Escape (cancel). There is no keyboard on a headset for these to collide
+// with, and on a desktop none of it runs, because Vr::Active() is false.
+constexpr float kVrNavStickThreshold = 0.5f;
+
+void SendVrNavKey(ImGuiKey key, bool down, bool& held) {
+    if (down == held) {
+        return;
+    }
+    held = down;
+    // Queued, not applied: ImGui drains the event queue in its next NewFrame, so
+    // a press made here is acted on one frame later. That is the same latency the
+    // SDL backend's own key events carry.
+    ImGui::GetIO().AddKeyEvent(key, down);
+}
+
+void FeedVrNavigation() {
+    static bool heldUp = false;
+    static bool heldDown = false;
+    static bool heldLeft = false;
+    static bool heldRight = false;
+    static bool heldActivate = false;
+    static bool heldCancel = false;
+
+    const bool wantNav = g_vrPanelVisible && Vr::Active();
+    Vr::ControllerState pad{};
+    if (wantNav) {
+        pad = Vr::CurrentControllers();
+        // Set once a session exists, and left set: it is a config flag no backend
+        // touches, and flapping it would drop navigation mid-press.
+        ImGui::GetIO().ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+    }
+    // delivering goes false the moment the session loses focus. Every key is then
+    // released rather than left down, which is the rule the pad side already
+    // keeps: a direction stuck down would walk the cursor through the whole panel
+    // while the player is away in the system menu.
+    const bool live = wantNav && pad.delivering;
+
+    // Either stick, whichever is further from centre. The left one is the
+    // documented navigation stick; the right one costs nothing to accept and is
+    // where a thumb that has just been driving already sits.
+    const float x = std::fabs(pad.trickX) > std::fabs(pad.steerX) ? pad.trickX : pad.steerX;
+    const float y = std::fabs(pad.trickY) > std::fabs(pad.steerY) ? pad.trickY : pad.steerY;
+
+    SendVrNavKey(ImGuiKey_UpArrow, live && y >= kVrNavStickThreshold, heldUp);
+    SendVrNavKey(ImGuiKey_DownArrow, live && y <= -kVrNavStickThreshold, heldDown);
+    SendVrNavKey(ImGuiKey_LeftArrow, live && x <= -kVrNavStickThreshold, heldLeft);
+    SendVrNavKey(ImGuiKey_RightArrow, live && x >= kVrNavStickThreshold, heldRight);
+    // Right hand: the item button, the trigger, or the simple profile's only
+    // button. Space and not Enter -- Enter is ImGui's "text input" activation and
+    // would ask for a keyboard nobody in a headset can type on.
+    const bool activate = pad.item || pad.select || pad.accelerate >= kVrNavStickThreshold;
+    SendVrNavKey(ImGuiKey_Space, live && activate, heldActivate);
+    // Left hand, which is where cancel already lives for the game's own menus.
+    SendVrNavKey(ImGuiKey_Escape, live && pad.back, heldCancel);
+}
+
+void DrawVrPanel() {
+    if (!g_vrPanelVisible) {
+        return;
+    }
+    if (g_vrPanelFocusPending) {
+        g_vrPanelFocusPending = false;
+        // Without this the thumbstick moves nothing: ImGui navigates the focused
+        // window, and a window that has only just appeared is not it.
+        ImGui::SetNextWindowFocus();
+        ImGui::SetNextWindowCollapsed(false);
+    }
+    const ImGuiViewport* viewport = ImGui::GetMainViewport();
+    const ImVec2 centre{
+        viewport->WorkPos.x + viewport->WorkSize.x * 0.5f,
+        viewport->WorkPos.y + viewport->WorkSize.y * 0.5f,
+    };
+    // Sized and scaled from the viewport rather than fixed in pixels, because
+    // this panel is not read on a monitor. It is drawn into the game's own frame
+    // buffer and that frame is then spread across the whole field of view, so a
+    // 470-pixel window with ImGui's default 13-pixel font comes out at a few
+    // minutes of arc -- present, correct, and completely unreadable. Two fifths
+    // of the picture's width, with the font scaled to match, puts it at about
+    // the size of the game's own menu text.
+    const float panelWidth = std::max(470.0f, viewport->WorkSize.x * 0.40f);
+    const float fontScale = std::max(1.0f, panelWidth / 470.0f);
+    ImGui::SetNextWindowPos(centre, ImGuiCond_Appearing, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSize(ImVec2(panelWidth, 0.0f), ImGuiCond_Always);
+    bool open = true;
+    if (ImGui::Begin("VR settings", &open, ImGuiWindowFlags_NoSavedSettings)) {
+        // Applies to this window only, so the desktop overlay next to it is
+        // untouched for anyone running the same build on a monitor.
+        ImGui::SetWindowFontScale(fontScale);
+        DrawVrSettings();
+        ImGui::Separator();
+        ImGui::TextDisabled("Stick to move, right trigger or A to change, left B to go back.");
+        ImGui::TextDisabled("Hold the menu button again to close.");
+    }
+    ImGui::End();
+    if (!open) {
+        g_vrPanelVisible = false;
+        SetTopBarVisible(false);
+        WriteBackVrSettings();
+    }
+}
