+// OpenXR side of the Quest build.
+//
+// The flat 2D panel of stage 0 needs none of this: with mode Panel nothing here
+// is started and the runtime behaves exactly as before. Cinema puts the
+// unchanged game image on one flat quad layer in the room; Stereo (stage 2) will
+// render the 3D scene once per eye. Everything OpenXR runs on its own host
+// thread, never on a guest fiber, and never touches poll_events or the settings
+// overlay -- those stay in the retrace context (the Fix AB rule).
+#pragma once
+
+#include <cstdint>
+
+namespace Vr {
+
+enum class Mode : uint8_t {
+    // No OpenXR session at all. The SDL surface is presented as today and the
+    // app is a flat panel in the Horizon shell.
+    Panel = 0,
+    // One flat quad layer in the room, head free to move around it. The game
+    // image is unchanged, so this is the fallback whenever Stereo misbehaves.
+    Cinema = 1,
+    // Per-eye projection layers instead of the quad. The game is rendered
+    // through the headset's own field of view with the head's rotation added to
+    // its camera, and the one image that comes back is submitted to both
+    // projection views with the same centre pose and the same field of view --
+    // there is no per-eye offset yet, so this costs no more to draw than one
+    // picture. The per-eye swapchains are built on the first stereo frame, not
+    // at startup, and until the renderer has delivered a frame this falls back
+    // to the flat screen.
+    Stereo = 2,
+};
