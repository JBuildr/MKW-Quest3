+#include "stereo.hpp"
+
+#include <aurora/stereo.h>
+
+#include <atomic>
+#include <cstring>
+
+#include "../logging.hpp"
+
+namespace aurora::gx {
+namespace {
+Module Log("aurora::gx");
+
+// The published pair, and a counter that is ODD exactly while it is being
+// written. A reader that sees the same even value before and after its copy has
+// copied one caller's pair whole.
+//
+// That is the failure this exists to rule out, and it is worth naming: a frame
+// staged with the previous head rotation next to the current field of view does
+// not look like a race, it looks like the world shearing sideways for one frame
+// whenever the head moves quickly, and it would be hunted for in the matrix
+// maths rather than here.
+//
+// A mutex would give the same guarantee and is deliberately not used.
+// aurora_set_stereo_view is called from the OpenXR frame loop, stereo_view()
+// from every single draw, so a lock would put the headset's frame loop behind
+// the game's draw loop -- exactly the blocking the contract in aurora/stereo.h
+// forbids, and the reason it says staleness is expected instead.
+StereoView g_published{};
+std::atomic<uint32_t> g_sequence{0};
+std::atomic<bool> g_installed{false};
+
+static_assert(sizeof(StereoView::view) == sizeof(AuroraStereoView::view) &&
+                  sizeof(StereoView::proj) == sizeof(AuroraStereoView::proj),
+              "the two matrices are copied straight across and must match in size");
+} // namespace
+
+bool stereo_view(StereoView& out) noexcept {
+  // The whole cost of this function on the flat panel, in Cinema, and in every
+  // draw of every build that never installs a view: one acquire load.
+  if (!g_installed.load(std::memory_order_acquire)) {
+    return false;
+  }
+  // Bounded, because this runs inside a draw. One writer at the display rate
+  // cannot beat a reader three times in a row, and giving up costs nothing that
+  // matters: the draw falls back to the game's own camera and projection for one
+  // frame, which is the path that always works.
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    const uint32_t before = g_sequence.load(std::memory_order_acquire);
+    if ((before & 1u) != 0u) {
+      continue; // a write is in progress
+    }
+    out = g_published;
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (g_sequence.load(std::memory_order_relaxed) == before) {
+      return true;
+    }
+  }
+  return false;
+}
