+// screen.frag:
+//   #version 450
+//
+//   layout(set = 0, binding = 0) uniform sampler2D gameImage;
+//
+//   layout(push_constant) uniform Push {
+//       mat4 mvp;
+//       vec4 options;
+//   } push;
+//
+//   layout(location = 0) in vec2 inTexCoord;
+//   layout(location = 0) out vec4 outColour;
+//
+//   void main() {
+//       vec3 rgb = texture(gameImage, inTexCoord).rgb;
+//       // options.x is 1.0 when the eye swapchain is an sRGB format. The shared
