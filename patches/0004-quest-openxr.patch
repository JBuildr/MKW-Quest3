@@ -193,6 +229,62 @@ inline bool IsSupportedFrameInterpolationFps(uint32_t value) {
     return value == 0 || value == 120 || value == 180;
 }
 
+// The [vr] defaults, the same numbers as the Vr::Settings defaults in
+// vr/vr_session.h. They are repeated instead of included so that the config layer
+// keeps compiling on hosts that have no OpenXR at all.
+inline constexpr float kVrScreenDistanceDefault = 2.5f;
+inline constexpr float kVrScreenWidthDefault = 3.2f;
+inline constexpr float kVrScreenHeightDefault = 1.8f;
+// Game units per metre, for mode stereo. Wii-era engines are usually built in
+// centimetre-sized units rather than in metres, so 100 is the right order of
+// magnitude to start from -- but that is a starting point and not a fact, which
+// is exactly why it is a setting: getting it wrong does not look broken, it
+// looks like the player is the wrong size. The renderer logs the near plane it
+// recovers from the game's own projection, in game units, and that is the one
+// real distance a candidate value can be checked against.
+inline constexpr float kVrWorldScaleDefault = 100.0f;
+// How much of the head's own movement, as opposed to its rotation, is added to
+// the game camera. Zero by default: the game's camera is on rails behind the
+// kart, so leaning sideways moves the eye while the world's camera stays where
+// it was, and the parallax that produces is one the game never intended. Turn it
+// up to 1.0 to measure world_scale, which is the only thing it visibly affects.
+inline constexpr float kVrHeadTranslationDefault = 0.0f;
+// Fraction of the thumbstick's travel treated as rest, removed radially with the
+// remaining travel rescaled so full lock is still full lock. The GameCube's own
+// clamp region calls 15 of 127 rest (about 0.118) and the game applies that on
+// top of whatever arrives here; 0.15 sits a little above it because a Touch
+// thumbstick is short-throw and springy and does not return to dead centre as
+// reliably as a GameCube one. It is a setting rather than a constant for the
+// same reason a dead zone always is: too small and the kart wanders on the
+// straights, too large and the small corrections that hold a drift disappear,
+// and only the person holding the controller can tell which is happening.
+inline constexpr float kVrControllerDeadzoneDefault = 0.15f;
+// -1: the Touch controllers take the first GameCube port no other controller is
+// using. With nothing else connected that is port 0, the port a single-player
+// game reads; with a pad connected it is port 1, which this game does not read,
+// so the pad simply keeps the race. Naming a port here overrides that, including
+// onto a port a pad already holds.
+inline constexpr int32_t kVrControllerPortAuto = -1;
+
+// Must stay in step with Vr::ModeFromString, which is what actually maps these to
+// Vr::Mode.
+inline bool IsSupportedVrMode(std::string_view value) {
+    static constexpr std::array<std::string_view, 3> values{
+        "panel", "cinema", "stereo",
+    };
+    return std::find(values.begin(), values.end(), value) != values.end();
+}
+
+// Kept next to its mode sibling and in the same shape. "default" means the
+// session asks the headset for nothing at all, which is the baseline the other
+// levels have to beat; the names match Vr::PerformanceFromString exactly.
+inline bool IsSupportedVrPerformance(std::string_view value) {
+    static constexpr std::array<std::string_view, 4> values{
+        "default", "sustained_low", "sustained_high", "boost",
+    };
+    return std::find(values.begin(), values.end(), value) != values.end();
+}
