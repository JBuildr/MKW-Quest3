+// What the session asks the headset to do with its clocks. The runtime does not
+// grant this by itself: a plain OpenXR app is left at the system's own choice,
+// which is why the shell's own performance lines appear in the log and ours do
+// not. Sustained levels are meant to be held for as long as the app runs; Boost
+// is meant for short transitions and invites thermal throttling, so it is worth
+// measuring rather than assuming.
+enum class Performance : uint8_t {
+    // Ask for nothing and leave the system its own choice. This is what the
+    // session did before the setting existed, and it is the baseline any
+    // measurement of the others has to beat.
+    Default = 0,
+    SustainedLow = 1,
+    SustainedHigh = 2,
+    Boost = 3,
+};
+
+// "default", "sustained_low", "sustained_high", "boost"; anything else, including
+// nullptr, is SustainedHigh.
+Performance PerformanceFromString(const char* text) noexcept;
+const char* PerformanceToString(Performance level) noexcept;
+
+// [vr] in Config.toml. The metre values describe the virtual screen of Cinema:
+// a screen 3.2 m wide at 2.5 m looks about like a large television.
+struct Settings {
+    Mode mode = Mode::Panel;
+    Performance performance = Performance::SustainedHigh;
+    float screenDistance = 2.5f;
+    float screenWidth = 3.2f;
+    float screenHeight = 1.8f;
+    // Lifts or lowers the screen centre relative to eye height, in metres.
+    float screenHeightOffset = 0.0f;
+    // False pins the screen to the head instead of the room. Only for
+    // comparing against the panel; the room-fixed screen is the point. In
+    // Stereo it means the stronger thing: the head's rotation is not added to
+    // the game's camera at all, which is the A/B that separates a wrong matrix
+    // from a wrong scale.
+    bool headTracking = true;
+    // Stereo only. Game units per metre: the game's world has no metre in it, so
+    // this is what turns the head's movement in the room into a movement of the
+    // game's camera. It cannot be derived here and it is not a constant -- see
+    // kVrWorldScaleDefault in runtime_config.h for why 100 is only a start.
+    float worldScale = 100.0f;
+    // Stereo only, 0 to 1: how much of the head's movement (not its rotation)
+    // reaches the game camera. Zero leaves the eye exactly where the game put
+    // its camera.
+    float headTranslation = 0.0f;
+    // Stereo only. Normally the per-eye path is used ONLY while the game is
+    // racing, because the menus are flat screens the game draws for a
+    // television and a camera placed inside one is not somewhere anybody wants
+    // to be. True forces per-eye everywhere, which is for comparing the two.
+    bool stereoInMenus = false;
+    // Takes the driver out of the picture and leaves the kart in it. Done in the
+    // game's own scene objects, before a single draw call is built, so it costs
+    // the renderer nothing and needs no shader change -- which matters, because
+    // the shader is where the Adreno workaround lives.
+    bool hideDriver = true;
+    // Stereo, in a race. True puts the eye in the driver's place; false leaves it
+    // exactly on the game's own chase camera, which is a way of playing in its
+    // own right -- the track as a room you are looking into -- and not a
+    // fallback. Outside a race neither applies: there is no kart to sit in.
+    bool egoCamera = true;
+    // The seat, in the GAME's units along the kart's own axes. The defaults are
+    // measured, not chosen: the driver's head bone sits 54 units above the kart's
+    // origin and 2 behind it. These dials trim that, they do not search for it.
+    float seatHeight = 54.0f;
+    float seatForward = -2.0f;
+    // Stereo only, metres. Moves the eye from where the game's chase camera sits
+    // towards where the driver's head is: forward is towards the kart, up is up.
+    // Zero leaves the eye exactly on the game's camera, which is where every
+    // build before this one put it. The kart stays drawn, deliberately -- seeing
+    // your own machine is what makes it feel like sitting in one.
+    // Stereo only, 0 to 1: how far from the game's own camera towards the kart
+    // the eye sits. This is the one that should be used. It needs no metre and
+    // no world scale, because both ends come from the game itself, and it CANNOT
+    // overshoot -- at 1 the eye is at the kart and there is no further to go.
+    // That matters: an eye past the kart leaves everything the game pins to the
+    // kart behind the player, the shake prompt and the warning that someone is
+    // coming up behind among them.
+    //
+    // Zero is the game's own chase camera. Used only while the game is racing
+    // and its kart can be read; everywhere else the two metre values below still
+    // apply, so a menu seen in stereo behaves as it did.
+    float cameraSeat = 0.0f;
+    float cameraForward = 0.0f;
+    float cameraUp = 0.0f;
+    // Stereo only. The game's 2D layer, in x and y.
+    //
+    // hudScale pulls it towards the centre of the view: the HUD is drawn for a
+    // television, and stretched over a headset's field of view the lap counter
+    // lands where nobody reads it. hudOffsetY slides it up or down, in the same
+    // units, which is what a pause screen sitting too low needs.
+    //
+    // The layer's DEPTH is deliberately untouched. Putting it on a plane in
+    // front of the eye also squeezed every orthographic z into one sliver, and
+    // elements that had been cleanly stacked began fighting for the same depth:
+    // the minimap lost the other racers and the pause screen lost its text.
+    // 1.0 with no offset leaves the layer exactly as the game drew it.
+    float hudScale = 0.55f;
+    float hudOffsetY = 0.0f;
+    // The Quest's own Touch controllers as a GameCube pad. False stops the
+    // session from ever publishing a controller state, which is what makes the
+    // guest's PAD path leave the statuses exactly as aurora built them -- the
+    // one switch that guarantees a plugged-in pad behaves as it did before this
+    // existed.
+    bool controllers = true;
+    // Fraction of the thumbstick's travel treated as rest, 0 to 0.9. Removed
+    // radially and the rest rescaled, so the stick still reaches full lock.
+    float controllerDeadzone = 0.15f;
+    // Which GameCube port the Touch controllers feed, or -1 for "the first port
+    // no other controller is using". A fixed port is the setting to reach for
+    // when the automatic choice picks the wrong one; it is deliberately allowed
+    // to name a port a real pad already holds, because that is a decision only
+    // the person holding both can make.
+    int8_t controllerPort = -1;
+};
+
+// "panel", "cinema", "stereo"; anything else, including nullptr, is Panel.
+Mode ModeFromString(const char* text) noexcept;
+// Always one of the three literals above, never nullptr.
+const char* ModeToString(Mode mode) noexcept;
+
+// Starts the OpenXR thread. Returns false when OpenXR is unavailable (no
+// loader, no runtime, no headset, mode Panel) after writing one line saying
+// which step failed; the caller then keeps the flat panel path and must not
+// treat it as fatal. Call once, from the host thread before the guest starts.
+bool Start(const Settings& settings) noexcept;
+
+// Ends the session and joins the thread. Safe to call when Start() failed or
+// was never called.
+void Stop() noexcept;
+
+// True once a session is running and frames are being submitted. Everything
+// that has to behave differently in VR asks this, so a failed Start() leaves
+// the rest of the runtime on its old path with no further conditions.
+bool Active() noexcept;
+
+Mode CurrentMode() noexcept;
+
+// Switches between Cinema and Stereo while the session keeps running; this is
+// what the settings menu calls. Panel cannot be entered or left this way
+// (Horizon OS decides panel or immersive when the app launches) and asking for
+// it returns false.
+bool SetMode(Mode mode) noexcept;
+
+// How long the menu button has to be held before it means "settings" instead of
+// "pause". A pair of Touch controllers has exactly one menu button -- the right
+// hand's is reserved by Horizon OS -- so the two jobs share it and are told apart
+// by the hold.
+//
+// 500 ms is Android's own long-press timeout, the duration every hand in a
+// headset has already been trained on, and it is far above a deliberate tap
+// (60-150 ms). The cost is stated where it is paid: because a short press cannot
+// be recognised until the button comes back up, Start is now sent on RELEASE, so
+// pause is late by however long the button was held -- about a tenth of a second
+// for a normal tap, and never more than the 500 ms below, since a press that
+// reaches it is the overlay and sends no Start at all.
+inline constexpr uint32_t kMenuLongPressMs = 500;
+
+// Edge-triggered request to open (or close) the settings overlay, raised ONCE per
+// hold by a long press of the controller's menu button. The reader consumes the
+// request, so exactly one caller may poll it.
+//
+// This is deliberately not ControllerState::menu below: that one is the same
+// button as the game's Start, and a hold that raises this request never sets it.
+bool ConsumeSettingsRequest() noexcept;
+
+// The [vr] dials the settings overlay may turn while the session is running.
+// Safe from any thread and cheap: each one writes an atomic that the session
+// thread folds into its own copy of Settings at the top of its next frame, so
+// nothing here reaches OpenXR, Vulkan or aurora on the caller's thread.
+//
+// Everything NOT listed here is read once by Start() and cannot be changed
+// without relaunching -- the overlay says so in as many words rather than
+// offering a control that quietly does nothing.
+// 0 to 1 along the camera-to-kart line; clamped, because past 1 is the very
+// thing this setting exists to prevent.
+void SetSeatFraction(float seat) noexcept;
+// Takes effect on the guest's next drawn frame, and putting the driver back is
+// the same call with false -- the bits are the game's own and are restored, not
+// overwritten with a guess.
+void SetHideDriver(bool hide) noexcept;
+// The seat itself. `ego` false hands the eye back to the game's chase camera;
+// the two lengths are game units along the kart's own axes and are clamped to
+// the same range the config parser accepts, so a dial can never reach a value
+// the file cannot hold and then write it back.
+void SetEgoCamera(bool ego) noexcept;
+void SetSeatPlacement(float height, float forward) noexcept;
+void SetSeat(float cameraForward, float cameraUp) noexcept;
+void SetHud(float hudScale, float hudOffsetY) noexcept;
+void SetWorldScale(float worldScale) noexcept;
+void SetHeadTranslation(float headTranslation) noexcept;
+void SetScreenPlacement(float screenDistance, float screenHeightOffset) noexcept;
+
+// One reading of the Quest's own controllers, already in the units the pad side
+// wants: sticks -1..1 with +y up and the dead zone taken out, pulls 0..1,
+// buttons as levels rather than edges. Everything here is what OpenXR reported
+// for the last synchronised frame; nothing in it is a pose, because a kart is
+// driven with a stick and a trigger and locating hands every frame would cost
+// the race loop for nothing.
+//
+// `delivering` is the whole safety story: it is true only when the session is
+// running, the runtime has given the app focus, xrSyncActions succeeded and at
+// least one action came back isActive -- that is, a real controller is bound to
+// a real binding. False means the caller must change nothing at all.
+struct ControllerState {
+    bool delivering = false;
+    // Separate from `delivering` on purpose, and the difference matters in the
+    // middle of a race. `delivering` goes false the moment the session loses
+    // focus -- the Meta button, a system dialog, the headset coming off -- which
+    // is right for the inputs themselves, because a button must not stay held
+    // while the player is somewhere else. But the game must not also see the
+    // CONTROLLER disappear: an empty port makes it drop back to "no controller",
+    // and that flicker in and out of a race is far worse than a moment of
+    // neutral input. `connected` stays true for as long as the session has a
+    // controller at all, so the port keeps existing while its inputs go quiet.
+    bool connected = false;
+    // Which GameCube port to feed, copied from the settings so the pad side
+    // needs no configuration of its own. -1 means "the first free port", which
+    // only the caller can resolve because only it can see the other sources.
+    int8_t port = -1;
+    // Left thumbstick: steering, and menu navigation.
+    float steerX = 0.0f;
+    float steerY = 0.0f;
+    // Right thumbstick. Stands in for the D-pad the Touch controllers do not
+    // have; see vr_pad.cpp for why that matters in this game.
+    float trickX = 0.0f;
+    float trickY = 0.0f;
+    // Trigger and squeeze pulls, 0 at rest and 1 at the stop.
+    float accelerate = 0.0f;
+    float brake = 0.0f;
+    float drift = 0.0f;
+    bool item = false;
+    // Cancel, and the menus are unusable without it. On the left hand, because
+    // the right hand's face buttons are already the item button and because
+    // nothing in a race is bound there -- an accidental press while driving
+    // would reach the game as B, which it reads together with R as one input.
+    bool back = false;
+    // Only ever true on a controller poor enough to have nothing but
+    // /input/select/click -- the Khronos simple profile. See CreateActions().
+    bool select = false;
+    // The game's Start, and NOT the raw menu button any more. The one menu
+    // button has to serve both pause and the settings overlay, so the session
+    // decides which on release: a short press becomes a fixed pulse here that is
+    // long enough for the game to see a press and a release, and a press held
+    // past kMenuLongPressMs raises the overlay request instead and never sets
+    // this at all. Without the pulse, a hold would pause the game on the way to
+    // opening the settings.
+    bool menu = false;
+};
+
+// Safe from any thread. The session thread publishes one of these per frame; the
+// guest's PAD path reads it. Neither side does anything but copy the struct while
+// it holds the lock, so neither can hold the other up.
+ControllerState CurrentControllers() noexcept;
+
+// Makes wherever the head is pointing now the direction the game's own camera
+// points, for mode Stereo. Only the heading is taken: recentring the pitch would
+// make looking down look level, and recentring the roll would leave the horizon
+// permanently tilted by however the head happened to be held.
+//
+// Safe from any thread, and cheap -- it only arms a flag the session thread
+// reads on its next frame. Entering Stereo arms it as well, so a player who
+// never calls this still starts facing forward.
+void RecentreStereo() noexcept;
+
+// Called on the GUEST thread at the end of each drawn frame, from GXCopyDisp.
+//
+// This is the one deliberate exception to "nothing here runs on a guest fiber".
+// What it does is READ the game's own matrices, and the only moment they are all
+// finished and none of them half-rewritten is the moment the frame that used
+// them has been drawn. Reading them from the session thread instead was measured
+// in build 45 and comes back torn: the driver's head from one frame and his kart
+// from the next, an exact frame of travel apart, flickering between zero, one
+// and two frames at speed. It takes no lock the guest could wait on, allocates
+// nothing, and calls into neither OpenXR nor the JVM, so it does not reopen the
+// fiber problem that shaped the rule.
+void SampleGuestFrame() noexcept;
+
+// Millisecond costs of the last completed second, for the log line behind the
+// vr debug bit. All zero while inactive.
+struct Stats {
+    double waitFrameMs = 0.0;
+    double renderMs = 0.0;
+    double submitMs = 0.0;
+    // Waiting on aurora's sync-file descriptor, and transferring the shared
+    // image into the swapchain image. The wait is a CPU cost only on a device
+    // that cannot import the descriptor as a semaphore; where it can, the wait
+    // happens on the GPU and lands inside transferMs instead.
+    double fenceWaitMs = 0.0;
+    double transferMs = 0.0;
+    // What the Stereo path costs on top: xrLocateViews for the frame's
+    // predicted display time, and everything the eyes then cost -- acquiring
+    // both eye images, recording and submitting the two render passes, and
+    // waiting the queue out. Both stay zero in Cinema, and on any stereo frame
+    // that fell back to the flat screen, so a second whose transfer is busy and
+    // whose eyes are zero is a second that never went per-eye.
+    double locateViewsMs = 0.0;
+    double eyeRenderMs = 0.0;
+    uint32_t framesPerSecond = 0;
+    uint32_t skippedFrames = 0;
+    // The handover, per second: frames aurora delivered, frames it was refused
+    // because the ring was full, and delivered frames dropped in favour of a
+    // newer one. All three are zero while the game image is not being shared.
+    uint32_t framesFromAurora = 0;
+    uint32_t rejectedFrames = 0;
+    uint32_t droppedFrames = 0;
+};
+Stats CurrentStats() noexcept;
+
+} // namespace Vr
