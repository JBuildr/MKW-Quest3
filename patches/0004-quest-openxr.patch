+
+void xr_abandon_shared_target_access(void* hardwareBuffer) noexcept {
+  // The frame is being given up before it was drawn, so there is nobody to hand a fence to. The
+  // access still has to be ended or the buffer stays checked out of this device forever, and the
+  // descriptor Dawn exports anyway has to be closed here, because the caller of this path has no
