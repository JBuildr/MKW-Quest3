+    pthread_t thread{};
+    if (::pthread_create(&thread, nullptr, AndroidLogPump,
+                         reinterpret_cast<void*>(static_cast<intptr_t>(fds[0]))) == 0) {
+        ::pthread_detach(thread);
+    } else {
+        ::close(fds[0]);
+    }
+}
