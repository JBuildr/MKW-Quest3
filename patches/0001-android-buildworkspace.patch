+// A hang gives no crash report, and a single sample only says where the guest
+// happened to be, not whether it is stuck. This reports the guest's position
+// on a fixed interval, so two consecutive lines answer the question: an
+// unchanged LR with an unchanged retrace count is a spin, and a moving retrace
+// count with an unchanged LR means VI advances while the guest waits for
+// something else.
+//
+// The reads are deliberately unsynchronised. This is diagnostics: a torn
+// 32-bit value costs one misleading line, while taking the locks the guest
+// thread holds would change the timing being measured.
+void* AndroidGuestWatchdog(void*) {
+    // VIWaitForRetrace and the retrace handler both keep the count here
+    // (hle/vi.cpp:142), so reading guest memory needs no new VI interface.
+    constexpr uint32_t kViRetraceCountAddr = 0x80386be4;
+    uint32_t previousActive = 0;
+    uint32_t previousRetraces = 0;
+    bool first = true;
+    for (;;) {
+        ::sleep(2);
+        // The persistent CPU context only syncs at bridge crossings, so its
+        // lr can name an epilogue the guest left long ago. The address the
+        // runtime itself reports for translated execution -- the one the crash
+        // reports print -- does not have that problem.
+        const uint32_t active = RecompMod::CurrentTranslatedExecutionAddress();
+        const CpuContext& cpu = GetPersistentCpuContext();
+        const uint32_t lr = cpu.lr;
+        (void)cpu;
+        uint32_t retraces = 0;
+        try {
+            retraces = Memory::Read32(kViRetraceCountAddr);
+        } catch (...) {
+            retraces = 0;
+        }
+        const bool stalled = !first && active == previousActive && retraces == previousRetraces;
+        RT_LOGF(RT_TAG_RUNTIME, "watchdog: active=0x%08X lr=0x%08X retraces=%u%s\n",
+                active, lr, retraces, stalled ? "  STALLED" : "");
+        previousActive = active;
+        previousRetraces = retraces;
+        first = false;
+    }
+    return nullptr;
+}
