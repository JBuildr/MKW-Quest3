+// to std::cerr and stderr (runtime_log.h:29,33). On Android a process's stdout
+// and stderr are connected to /dev/null, so every diagnostic is discarded --
+// including the reason a refused start gave, which is exactly the message
+// worth having. Pump both into logcat, where "adb logcat -s mkw" shows them.
+void* AndroidLogPump(void* argument) {
+    const int readEnd = static_cast<int>(reinterpret_cast<intptr_t>(argument));
+    std::string line;
+    char buffer[512];
+    for (;;) {
+        const ssize_t count = ::read(readEnd, buffer, sizeof(buffer));
+        if (count <= 0) {
+            break;
+        }
+        for (ssize_t index = 0; index < count; ++index) {
+            const char character = buffer[index];
+            if (character == '\n') {
+                __android_log_write(ANDROID_LOG_INFO, "mkw", line.c_str());
+                line.clear();
+            } else if (character != '\r') {
+                line.push_back(character);
+            }
+        }
+        // A writer that never emits a newline must not grow this without bound.
+        if (line.size() >= 4096) {
+            __android_log_write(ANDROID_LOG_INFO, "mkw", line.c_str());
+            line.clear();
+        }
