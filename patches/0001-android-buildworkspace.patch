+void RedirectStandardStreamsToLogcat() {
+    int fds[2];
+    if (::pipe(fds) != 0) {
+        return;
+    }
+    // Unbuffered stderr so a message that precedes a crash still reaches the
+    // pipe; line-buffered stdout is enough for the rest.
+    ::setvbuf(stdout, nullptr, _IOLBF, 0);
+    ::setvbuf(stderr, nullptr, _IONBF, 0);
+    ::dup2(fds[1], STDOUT_FILENO);
+    ::dup2(fds[1], STDERR_FILENO);
+    ::close(fds[1]);
