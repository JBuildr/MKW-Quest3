diff --git a/translator/src/Translator.Core/IO/AssemblyTargetPlatform.cs b/translator/src/Translator.Core/IO/AssemblyTargetPlatform.cs
new file mode 100644
index 0000000..1bcdbd4
--- /dev/null
+++ b/translator/src/Translator.Core/IO/AssemblyTargetPlatform.cs
@@ -0,0 +1,67 @@
+using System;
+
+namespace Translator.Core.IO;
+
+/// <summary>
+/// The object-file flavour the emitted assembly has to speak. PE/COFF, Mach-O
+/// and ELF spell sections and symbol decoration differently in GNU-as syntax.
+/// </summary>
+public enum AssemblyTargetPlatform
+{
+    Windows,
+    MacOS,
+    Elf,
+}
+
+/// <summary>
+/// Which object-file flavour <see cref="AssemblyBlobWriter"/> emits for.
+/// <para>
+/// This used to be read straight off the machine the translator runs on,
+/// because a build always targeted its own host. Cross-compiling breaks that:
+/// the Android arm64 build is produced on a Windows host, and a
+/// <c>.section .rdata,"dr"</c> emitted there is rejected by the NDK assembler,
+/// which wants ELF. The host stays the default, so nothing changes for a
+/// native build; a cross build states its target instead of being guessed at.
+/// </para>
+/// </summary>
+public static class AssemblyTarget
+{
+    public static AssemblyTargetPlatform Current { get; set; } = Host;
+
+    public static AssemblyTargetPlatform Host =>
+        OperatingSystem.IsWindows() ? AssemblyTargetPlatform.Windows
+        : OperatingSystem.IsMacOS() ? AssemblyTargetPlatform.MacOS
+        : AssemblyTargetPlatform.Elf;
+
+    /// <summary>
+    /// Accepts the names a caller would reach for. Android and Linux are the
+    /// same answer here: both are ELF, and the difference between bionic and
+    /// glibc never reaches an assembler directive.
+    /// </summary>
+    public static bool TryParse(string? value, out AssemblyTargetPlatform platform)
+    {
+        switch (value?.Trim().ToLowerInvariant())
+        {
+            case "windows":
+            case "win":
+            case "pe":
+            case "coff":
+                platform = AssemblyTargetPlatform.Windows;
+                return true;
+            case "macos":
+            case "osx":
+            case "darwin":
+            case "macho":
+                platform = AssemblyTargetPlatform.MacOS;
+                return true;
+            case "linux":
+            case "android":
+            case "elf":
+                platform = AssemblyTargetPlatform.Elf;
+                return true;
+            default:
+                platform = Host;
+                return false;
+        }
+    }
+}
